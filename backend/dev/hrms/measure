#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 2 ]]; then
    printf '%s\n' 'Usage: measure test-<name>.localhost STATUS_FILE' >&2
    exit 2
fi

dev_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
revision="$(git -C "$dev_dir" rev-parse HEAD)"
status_file="$2"
if [[ "$status_file" != /* ]]; then
    status_file="$PWD/$status_file"
fi

"$dev_dir/compose" exec -T web env/bin/python /workspace/hrms/measure.py \
    --site "$1" --revision "$revision" | tee -a "$status_file"
