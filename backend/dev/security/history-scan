#!/usr/bin/env bash
set -euo pipefail

if [[ "$(git rev-parse --is-shallow-repository)" != false ]]; then
    printf '%s\n' 'Secret scanning requires a complete Git checkout.' >&2
    exit 1
fi

image=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
ignore_file="$(dirname "${BASH_SOURCE[0]}")/.gitleaksignore"
GITLEAKS_IGNORES="$(cat "$ignore_file")"
export GITLEAKS_IGNORES

git bundle create - --all HEAD |
    docker --context colima-factory run --rm -i --pull never --network none \
        --env GITLEAKS_IGNORES --entrypoint /bin/sh "$image" -ec '
            cat > /tmp/history.bundle
            git clone --quiet --mirror /tmp/history.bundle /tmp/scan.git
            git -C /tmp/scan.git fetch --quiet /tmp/history.bundle HEAD:refs/gitleaks/scan-head
            printf "%s\n" "$GITLEAKS_IGNORES" > /tmp/.gitleaksignore
            exec gitleaks git --no-banner --verbose --redact=100 \
                --gitleaks-ignore-path /tmp/.gitleaksignore --log-opts="--all" /tmp/scan.git'
