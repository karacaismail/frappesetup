#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../../.."
rules=backend/dev/security/fixtures
semgrep=(uvx --python 3.12 semgrep@1.186.0)
gitleaks=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f

scan_secrets() {
    # Colima cannot mount this checkout. Transfer a read-only source snapshot.
    git ls-files -z --cached --others --deduplicate --exclude-standard -- backend |
        while IFS= read -r -d '' file; do
            if [[ -f "$file" && ! -L "$file" ]]; then
                printf '%s\0' "$file"
            fi
        done |
        tar --null -T - -cf - |
        docker --context colima-factory run --rm -i --network none --entrypoint /bin/sh \
            "$gitleaks" -ec 'mkdir /scan
                tar -xf - -C /scan
                exec gitleaks dir --redact=100 /scan/backend'
}

status=0
"${semgrep[@]}" --test --strict --metrics=off "$rules" || status=1
"${semgrep[@]}" scan --error --strict --metrics=off \
    --config "$rules/rules.yaml" --config "$rules/jinja.yaml" \
    --exclude 'backend/dev/security/fixtures/' backend || status=1
scan_secrets || status=1
python3 -B -m unittest discover -s backend/dev/security -p test_endpoints.py || status=1
python3 -B backend/dev/security/endpoints.py backend || status=1
exit "$status"
