#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../../.."
rules=backend/dev/guvenlik/fixtures
source backend/dev/security/container-settings
semgrep=(uvx --python 3.12 --exclude-newer "$TOOL_CUTOFF" "semgrep@$SEMGREP_VERSION")
export SEMGREP_ENABLE_VERSION_CHECK=0

scan_secrets() {
    # Colima cannot mount this checkout. Transfer a read-only source snapshot.
    git ls-files -z --cached --others --deduplicate --exclude-standard -- backend |
        while IFS= read -r -d '' file; do
            if [[ -f "$file" && ! -L "$file" ]]; then
                printf '%s\0' "$file"
            fi
        done |
        tar --null -T - -cf - |
        "${docker_command[@]}" run "${container_flags[@]}" "$gitleaks_image" -ec 'mkdir /tmp/scan
                tar -xf - -C /tmp/scan
                exec gitleaks dir --redact=100 /tmp/scan/backend'
}

status=0
"${semgrep[@]}" --test --strict --metrics=off "$rules" || status=1
"${semgrep[@]}" scan --error --strict --metrics=off \
    --config "$rules/rules.yaml" --config "$rules/jinja.yaml" \
    --exclude 'backend/dev/guvenlik/fixtures/' --exclude 'backend/dev/security/fixtures/' backend || status=1
if backend/dev/security/history-scan --self-test; then
    scan_secrets || status=1
else
    status=1
fi
python3 -B -m unittest discover -s backend/dev/guvenlik -p test_endpoints.py || status=1
python3 -B backend/dev/guvenlik/endpoints.py backend || status=1
backend/dev/bin/ai-readiness --self-test || status=1
if commit_base="$(git merge-base HEAD refs/heads/backend)"; then
    backend/dev/bin/ai-readiness --commit-base "$commit_base" || status=1
else
    printf '%s\n' 'Cannot find the common ancestor of HEAD and refs/heads/backend.' >&2
    status=1
fi
exit "$status"
