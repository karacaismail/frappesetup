#!/bin/bash
set -euo pipefail
DEV_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
APP="${1:-platform_core}"
if [[ ! "$APP" =~ ^[a-z][a-z0-9_]*$ ]]; then
    printf '%s\n' 'Expected an installed app name, such as platform_core.' >&2
    exit 2
fi
shift || true
SITE="test-${APP//_/-}.localhost"
python3 "$DEV_DIR/init_env.py"
"$DEV_DIR/bin/compose" config --quiet
"$DEV_DIR/bin/compose" build kiraci-web
"$DEV_DIR/bin/compose" up -d --wait --wait-timeout 90 kiraci-db kiraci-redis
"$DEV_DIR/bin/compose" run --rm --no-deps kiraci-web \
    env/bin/python /workspace/dev/bootstrap.py "$SITE" --app "$APP"
"$DEV_DIR/bin/compose" run --rm --no-deps kiraci-web \
    bench --site "$SITE" migrate --skip-search-index
"$DEV_DIR/bin/compose" run --rm --no-deps kiraci-web \
    bench --site "$SITE" run-tests --app "$APP" "$@"
