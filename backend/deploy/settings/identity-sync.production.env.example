# Kullanıcı eşitleme servisinin (identity-sync) üretim ayarları.
# Sunucudaki yeri: /etc/atonota/<ortam>/identity-sync.env (izin 0600).
# Bu dosya yalnız anahtar adlarını ve değer biçimini gösterir. Gerçek değer bu dosyaya yazılmaz.
# İmaj IDENTITY_SYNC_HOST, IDENTITY_SYNC_PORT ve IDENTITY_SYNC_DB değerlerini kendisi verir.
# Anlamları identity/identity_sync/.env.example ve README.md dosyalarındadır.

# Tarayıcının gördüğü Keycloak adresi. Belirtecin iss değeri bundan çıkar. Örnek: https://api.login.atonota.net
IDENTITY_SYNC_KEYCLOAK_PUBLIC_URL=<https://Keycloak adresi>
# [isteğe bağlı] Servisin Keycloak'a iç ağdan ulaştığı adres. Yazılmazsa genel adres kullanılır.
IDENTITY_SYNC_KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# [isteğe bağlı] Realm adı. Yazılmazsa platform olur.
IDENTITY_SYNC_REALM=platform
# [isteğe bağlı] Realm'in iç kimliği. Keycloak ilk açılışta üretir. Yönetim API'sinden okunur.
# Keycloak olayları üretimde henüz bu servise ulaşmıyor (engel E-16). Olaylar açılınca bu değer gerekir.
IDENTITY_SYNC_REALM_ID=<realm iç kimliği, UUID>
# [isteğe bağlı] Keycloak'taki istemci adı. Yazılmazsa identity-sync olur.
IDENTITY_SYNC_CLIENT_ID=identity-sync
# Keycloak istemci sırrı. keycloak.env içindeki ATONOTA_IDENTITY_SYNC_SECRET ile aynıdır.
IDENTITY_SYNC_CLIENT_SECRET=<identity-sync istemci sırrı, en az 32 karakter>
# [isteğe bağlı] Yönetim API belirtecinin kapsamı. Yazılmazsa "admin-api kc-admin-api" olur.
IDENTITY_SYNC_ADMIN_SCOPE=admin-api kc-admin-api
# Önizleme özetlerinin gizli anahtarı. En az 16 karakter olmalı.
IDENTITY_SYNC_DIGEST_KEY=<özet anahtarı, en az 32 rastgele karakter>
# Press sitesinin iç adresi. Adres HTTP ile ve 8080 portuyla yazılır. Örnek: http://press.atonota.net:8080
# Servis Press'e yalnız identity-press ağından ulaşır. Bu ağ internete açık değildir (O-55).
# Bu ağda Press adı press-frontend kabını gösterir. Press'in API'leri kenar vekilde kapalıdır.
IDENTITY_SYNC_PRESS_URL=<http://Press adı:8080>
# Kiracı listesi, tek satır JSON. Her kiracı için ad, adres ve kurum yazılır.
# Örnek: [{"name":"tenant1","base_url":"https://demo.app.atonota.net","organization":"tenant1"}]
IDENTITY_SYNC_TENANTS=<[{"name":"kiracı adı","base_url":"https://kiracı adresi","organization":"kurum adı"}]>
# Olay ucunun imza anahtarı. En az 16 karakter olmalı.
# keycloak.env içindeki KC_SPI_EVENTS_LISTENER__WEBHOOK__SECRET ile aynıdır.
IDENTITY_SYNC_WEBHOOK_SECRET=<olay imza anahtarı, en az 32 rastgele karakter>
# [isteğe bağlı] Servis belirtecinin hedef adı. Yazılmazsa identity-sync olur.
IDENTITY_SYNC_AUDIENCE=identity-sync
# [isteğe bağlı] Onaylı işi yürüten istemciler, virgülle ayrılır. Kiracı servis istemcileridir.
IDENTITY_SYNC_EXECUTE_AZP=<site-kiracı adı-service>
# [isteğe bağlı] Oturum kapatabilen istemciler. EXECUTE_AZP listesiyle aynı olur.
IDENTITY_SYNC_SESSION_AZP=<site-kiracı adı-service>
# [isteğe bağlı] Davet önizleyebilen istemciler, virgülle ayrılır. Yapay zekâ aracısı bu listededir.
IDENTITY_SYNC_PREVIEW_AZP=<önizleme istemcisi adı>
# [isteğe bağlı] Kuyruk ve mutabakat işlerini yapabilen istemciler.
IDENTITY_SYNC_OPERATOR_AZP=identity-sync-operator
# [isteğe bağlı] Hesap silme isteyebilen istemci. Yazılmazsa press-service olur.
IDENTITY_SYNC_DELETION_AZP=press-service
# [isteğe bağlı] Bir istemci adresinin dakikada gönderebileceği istek. Yazılmazsa 600 olur.
IDENTITY_SYNC_RATE_LIMIT=600
# [isteğe bağlı] Bir HTTP isteğinin bekleme süresi, saniye. Yazılmazsa 10 olur.
IDENTITY_SYNC_HTTP_TIMEOUT=10
# [isteğe bağlı] Bir anonimleştirme çağrısının bekleme süresi, saniye. En çok 80 olur.
IDENTITY_SYNC_ANONYMIZE_TIMEOUT=30
# [isteğe bağlı] İş kilidini bekleme süresi, saniye. Yazılmazsa 10 olur.
IDENTITY_SYNC_LOCK_TIMEOUT=10
