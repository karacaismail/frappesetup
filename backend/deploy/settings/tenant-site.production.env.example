# Her kiracı sitesinin üretim ayarları. Yeri: kiracı birimindeki sites/<site>/site_config.json dosyası.
# Bu dosya yalnız anahtar adlarını ve değer biçimini gösterir. Gerçek değer bu dosyaya yazılmaz.
# DevOps sorumlusu her anahtarı ilk kurulumda tenant-web kapsayıcısında yazar. Örnek:
#   bench --site <site> set-config <anahtar> '<değer>'
# Liste ya da sayı olan değerde --parse seçeneği eklenir. Örnek:
#   bench --site <site> set-config --parse identity_service_azp '["identity-sync"]'
# Sözleşme: backend/docs/contracts.md, 8. bölüm. Frappe'nin kendi yazdığı db_name, db_password ve
# encryption_key bu listede yoktur.

# Tarayıcının gördüğü Keycloak adresi. Örnek: https://id.atonota.net
keycloak_public_url=<https://Keycloak adresi>
# [isteğe bağlı] Sunucunun Keycloak'a ulaştığı adres. Kod yalnız HTTPS kabul eder. Boş bırakın.
keycloak_internal_url=<boş>
# [isteğe bağlı] Realm adı. Yazılmazsa "platform" olur.
keycloak_realm=platform
# Sitenin tarayıcı istemcisi. Keycloak'taki istemci adıdır. Örnek: site-tenant1
keycloak_client_id=<site-kiracı adı>
# Tarayıcı istemcisinin sırrı. Keycloak'taki istemcinin sırrıyla aynı olur.
keycloak_client_secret=<site istemci sırrı, en az 32 karakter>
# Sitenin servis istemcisi. Adı tarayıcı istemcisinin adına "-service" eklenerek bulunur.
keycloak_service_client_id=<site-kiracı adı-service>
# Servis istemcisinin sırrı. Keycloak'taki servis istemcisinin sırrıyla aynı olur.
keycloak_service_client_secret=<kiracı servis sırrı, en az 32 karakter>
# Giriş düğmesinde görünen marka adı. Örnek: Atonota
identity_brand_name=<marka adı>
# Çıkıştan sonra açılan adres. Örnek: https://demo.app.atonota.net/panel
platform_panel_url=<https://kiracı adresi/panel>
# Sitenin tam adresi. Telefon isteklerinin kaynağı bu adresle karşılaştırılır.
host_name=<https://kiracı adresi>
# Silinen hesapların kimlik özetinin anahtarı. Sonradan değişmez. Değişirse silinen hesap yeniden açılabilir.
kimlik_deletion_hmac_key=<silme özeti anahtarı, en az 32 rastgele karakter>
# Telefon eşitlemesinin imleç anahtarı. En az 32 karakter olmalı.
mobile_cursor_key=<imleç anahtarı, en az 32 rastgele karakter>

# [isteğe bağlı] 1 olursa yalnız Keycloak ile giriş açılır.
identity_keycloak_only=<0 ya da 1>
# [isteğe bağlı] identity-sync servisinin istemci adları, JSON listesi. Yazılmazsa ["identity-sync"] olur.
identity_service_azp=["identity-sync"]
# [isteğe bağlı] Telefon uygulamasının istemci adları, JSON listesi. Yazılmazsa ["mobile"] olur.
# Realm'deki telefon istemcisinin adı mobile-app'tir. Bu yüzden değeri yazın.
kimlik_mobil_azp=["mobile-app"]
# [isteğe bağlı] Yapay zekâ aracı belirtecinin hedef adı. Yazılmazsa agent-service olur.
ai_agent_audience=agent-service
# [isteğe bağlı] Telefon iptal isteğinin gittiği identity-sync adresi. Kod yalnız HTTPS kabul eder.
# identity-sync servisinin üretimde HTTPS adresi henüz yok (engel E-16).
mobile_identity_sync_url=<https://identity-sync adresi>
# [isteğe bağlı] Telefonda kapalı komutlar, JSON listesi.
mobile_disabled_commands=[]
# [isteğe bağlı] Telefon kayıtlarının saklama süresi, gün. Yazılmazsa 30 gün olur. 1 ile 3650 arasıdır.
mobile_operation_retention_days=30
# [isteğe bağlı] Telefon güncelleme kayıtlarının saklama süresi, gün.
mobile_upsert_retention_days=30
# [isteğe bağlı] Telefon silme kayıtlarının saklama süresi, gün.
mobile_removal_retention_days=30
# [isteğe bağlı] Üretimde yazılmaz. Yalnız geliştirmede HTTP'ye izin verir.
mobile_allow_development_http=0
# [isteğe bağlı] Üretimde yazılmaz ya da 0 olur.
developer_mode=0
# [isteğe bağlı] Yapay zekâ erişimi (MCP) için OAuth. 1 olursa aşağıdaki dört anahtar da gerekir.
mcp_oauth_enabled=<0 ya da 1>
# [isteğe bağlı] MCP ucunun tam adresi. Yol /api/method/platform_core.api.ai.mcp olur.
mcp_oauth_resource=<https://kiracı adresi/api/method/platform_core.api.ai.mcp>
# [isteğe bağlı] MCP istemcilerinin adları, JSON listesi.
mcp_oauth_client_ids=<["mcp istemci adı"]>
# [isteğe bağlı] Keycloak'taki MCP belirteç denetimi sırrı. keycloak.env içindeki ATONOTA_MCP_INTROSPECTION_SECRET ile aynıdır.
mcp_oauth_introspection_secret=<MCP denetim sırrı, en az 32 karakter>
# [isteğe bağlı] Panelin bağlantı verebileceği dış adların JSON listesi.
shell_navigation_hosts=[]
# [isteğe bağlı] Telefonda açılan DocType adları, JSON listesi.
shell_mobile_doctypes=[]
# [isteğe bağlı] Panelde kısıtlı DocType adları, JSON listesi.
shell_restricted_doctypes=[]
# [isteğe bağlı] Panelde gizli alanlar, JSON nesnesi. Anahtar DocType adı, değer alan listesidir.
shell_restricted_fields={}
# [isteğe bağlı] Model geçidinin izinli adresleri, JSON nesnesi. Ayrıntı contracts.md 11. bölümdedir.
model_gateway_endpoints={}
# [isteğe bağlı] Bir kullanıcının dakikada gönderebileceği model isteği. Yazılmazsa 30 olur.
model_gateway_user_requests_per_minute=30
# [isteğe bağlı] HRMS TR kayıtlarının saklama süresi, gün. Süreyi hukuk sorumlusu belirler.
hrms_tr_retention_days=<gün sayısı>
