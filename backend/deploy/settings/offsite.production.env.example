# Production settings of the offsite backup. Location on the server: /etc/atonota/<env>/offsite.env (mode 0600).
# rc and prod require this file. It is optional for alpha and beta. If the file exists, it must be complete.
# This file shows only key names and value formats. Real values are never written here.
# The backup goes to a Hetzner Object Storage bucket with rclone. rclone reads its settings from the environment.

# Backup destination: the rclone remote name, a colon and the bucket name.
# The remote name stays "offsite". The RCLONE_CONFIG_OFFSITE_ keys below use this name.
ATONOTA_OFFSITE_REMOTE=<offsite:kova adı, örnek: offsite:atonota-prod-yedek>
# [sabit] Remote type. Hetzner Object Storage is S3 compatible.
RCLONE_CONFIG_OFFSITE_TYPE=s3
# S3 provider name. Pick the value from the S3 provider list in the rclone documentation.
RCLONE_CONFIG_OFFSITE_PROVIDER=<rclone S3 sağlayıcı adı>
# Regional endpoint of the bucket.
RCLONE_CONFIG_OFFSITE_ENDPOINT=<https://bölge.your-objectstorage.com>
# Access key that can write to this bucket only.
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=<Object Storage erişim anahtarı kimliği>
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=<Object Storage gizli erişim anahtarı>
