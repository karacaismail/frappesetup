# Press sitesinin üretim ayarları. Yeri: Press birimindeki sites/<site>/site_config.json dosyası.
# Bu dosya yalnız anahtar adlarını ve değer biçimini gösterir. Gerçek değer bu dosyaya yazılmaz.
# Press imajı vardır, ama Press sitesi henüz açılmadı (engel E-2). Dağıtım bu listeyi bugün denetlemez. Liste press_tr kodundan çıkarıldı.
# DevOps sorumlusu her anahtarı bench --site <site> set-config <anahtar> '<değer>' ile yazar.

# Tarayıcının gördüğü Keycloak adresi. Örnek: https://api.login.atonota.net
keycloak_public_url=<https://Keycloak adresi>
# [isteğe bağlı] Sunucunun Keycloak'a ulaştığı adres. Yazılmazsa genel adres kullanılır.
# Üretimde boş bırakın. Press kapları ayrı ağdadır ve Keycloak kabına ulaşamaz.
keycloak_internal_url=<boş>
# Realm adı.
keycloak_realm=platform
# [sabit] Press'in tarayıcı istemcisi.
keycloak_client_id=press
# Press istemcisinin sırrı. keycloak.env içindeki ATONOTA_PRESS_SECRET ile aynıdır.
keycloak_client_secret=<Press istemci sırrı, en az 32 karakter>
# Press servis istemcisinin sırrı. keycloak.env içindeki ATONOTA_PRESS_SERVICE_SECRET ile aynıdır.
press_service_client_secret=<Press servis sırrı, en az 32 karakter>
# Press sitesinin tam adresi. Örnek: https://press.atonota.net
host_name=<https://Press adresi>
# Çıkıştan sonra açılan panel adresi.
platform_panel_url=<https://kiracı adresi/panel>
# Hesap silme isteğinin gittiği identity-sync adresi. Değer sabittir.
# press-web bu adrese yalnız press-identity ağından ulaşır. Bu ağ internete açık değildir (E-16).
identity_sync_url=http://identity-sync:6115
# identity-sync servisinin Press'teki kullanıcısı. "Website User" türünde olur. Administrator olamaz.
press_identity_sync_user=<identity-sync kullanıcısının e-posta adı>
# Silinen hesap özetinin anahtarı. Yazılmazsa Frappe'nin encryption_key değeri kullanılır.
press_anonymization_hmac_key=<silme özeti anahtarı, en az 32 rastgele karakter>
# [isteğe bağlı] Frappe bu anahtarı site açılırken kendisi yazar. Elle değiştirmeyin.
encryption_key=<Frappe'nin yazdığı değer>
# [isteğe bağlı] Hesap silme isteğinin bekleme süresi, saniye. En çok 90 olur.
press_deletion_request_timeout=<saniye>
# [isteğe bağlı] G-8 Team Tier tablosu. Ürün sahibi onaylar. Fiyat kapısı G-166 kapalıdır.
# Biçim JSON nesnesidir. Her Press Team Tier adı bir kez geçer. Alanlar amount ve last_invoice_amount alanlarıdır.
# Yazılmazsa güncelleme Team Tier kayıtlarını değiştirmez. Yazarken set-config komutuna -p ekleyin.
press_tr_team_tiers=<onaylı Team Tier tablosu, JSON>
# [isteğe bağlı] G-8 için kullanılan Cluster adları. Altyapı sorumlusu verir.
# Biçim JSON listesidir. Yazılmazsa güncelleme Cluster ve Server Plan kayıtlarını değiştirmez.
press_tr_enabled_clusters=<kullanılan Cluster adları, JSON listesi>
