# Production settings of the tenant database (MariaDB). Location on the server: /etc/atonota/<env>/tenant-db.env (mode 0600).
# This file shows only key names and value formats. Real values are never written here.

# MariaDB root password. bench new-site and bench restore need it. Each environment has its own.
MARIADB_ROOT_PASSWORD=<MariaDB kök parolası, en az 32 rastgele karakter>
