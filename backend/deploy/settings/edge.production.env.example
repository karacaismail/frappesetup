# Ön vekilin (Caddy) üretim ayarı. Sunucudaki yeri: /etc/atonota/edge.env.
# Bir sunucunun bütün ortamları bu tek dosyayı okur.
# Bu dosya yalnız anahtar adlarını ve değer biçimini gösterir. Gerçek değer bu dosyaya yazılmaz.

# Sertifika süresi dolmadan uyarı gelen e-posta adresi. Kişi adresi değil, ekip adresi yazın.
ATONOTA_ACME_EMAIL=<ekibin e-posta adresi, örnek: ops@alan-adi.example>
