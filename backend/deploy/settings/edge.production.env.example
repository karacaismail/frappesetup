# Production setting of the edge proxy (Caddy). Location on the server: /etc/atonota/edge.env.
# Every environment on a server reads this one file.
# This file shows only key names and value formats. Real values are never written here.

# Email address that gets the warning before a certificate expires. Use a team address, not a personal one.
ATONOTA_ACME_EMAIL=<ekibin e-posta adresi, örnek: ops@alan-adi.example>
