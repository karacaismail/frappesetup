# Production settings of the tenant containers. Location on the server: /etc/atonota/<env>/tenant.env (mode 0600).
# This file shows only key names and value formats. Real values are never written here.
# Frappe 16 reads these four values from the environment (frappe/config.py and node_utils.js).
# The values are service names from stack.yaml. They are the same in every environment.

# [sabit] Name of the MariaDB service.
FRAPPE_DB_HOST=tenant-db
# [sabit] MariaDB portu.
FRAPPE_DB_PORT=3306
# [sabit] Address of the cache Redis.
FRAPPE_REDIS_CACHE=redis://tenant-redis-cache:6379
# [sabit] Address of the job queue Redis. The socket server uses it too.
FRAPPE_REDIS_QUEUE=redis://tenant-redis-queue:6379
