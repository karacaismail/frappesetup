# Kiracı kapsayıcılarının üretim ayarları. Sunucudaki yeri: /etc/atonota/<ortam>/tenant.env (izin 0600).
# Bu dosya yalnız anahtar adlarını ve değer biçimini gösterir. Gerçek değer bu dosyaya yazılmaz.
# Frappe 16 bu dört değeri ortamdan okur (frappe/config.py ve node_utils.js).
# Değerler stack.yaml dosyasındaki servis adlarıdır. Her ortamda aynıdır.

# [sabit] MariaDB servisinin adı.
FRAPPE_DB_HOST=tenant-db
# [sabit] MariaDB portu.
FRAPPE_DB_PORT=3306
# [sabit] Önbellek Redis adresi.
FRAPPE_REDIS_CACHE=redis://tenant-redis-cache:6379
# [sabit] İş kuyruğu Redis adresi. Soket sunucusu da bu adresi kullanır.
FRAPPE_REDIS_QUEUE=redis://tenant-redis-queue:6379
