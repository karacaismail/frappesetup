# Keycloak veritabanının (PostgreSQL) üretim ayarları. Sunucudaki yeri: /etc/atonota/<ortam>/keycloak-db.env (izin 0600).
# Bu dosya yalnız anahtar adlarını ve değer biçimini gösterir. Gerçek değer bu dosyaya yazılmaz.

# [sabit] Kullanıcı adı. stack.yaml Keycloak'a bu adı verir.
POSTGRES_USER=keycloak
# [sabit] Veritabanı adı. stack.yaml Keycloak'a bu adı verir.
POSTGRES_DB=keycloak
# Veritabanı parolası. keycloak.env dosyasındaki KC_DB_PASSWORD ile aynı olur.
POSTGRES_PASSWORD=<Keycloak veritabanı parolası, en az 32 rastgele karakter>
