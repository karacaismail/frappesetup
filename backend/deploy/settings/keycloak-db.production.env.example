# Production settings of the Keycloak database (PostgreSQL). Location on the server: /etc/atonota/<env>/keycloak-db.env (mode 0600).
# This file shows only key names and value formats. Real values are never written here.

# [sabit] User name. stack.yaml gives Keycloak this name.
POSTGRES_USER=keycloak
# [sabit] Database name. stack.yaml gives Keycloak this name.
POSTGRES_DB=keycloak
# Database password. It equals KC_DB_PASSWORD in keycloak.env.
POSTGRES_PASSWORD=<Keycloak veritabanı parolası, en az 32 rastgele karakter>
