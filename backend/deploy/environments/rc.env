# Non-secret settings of the rc environment. Secrets live only on the server (docs/dagitim/ortamlar.md).
ATONOTA_ENV=rc
ATONOTA_PREVIOUS_ENV=beta
ATONOTA_SSH_HOST=atonota-rc
ATONOTA_SSH_USER=deploy-rc
ATONOTA_BASE_HOST=rc.atonota.net
ATONOTA_ID_HOST=api.login.rc.atonota.net
ATONOTA_PRESS_HOST=press.rc.atonota.net
ATONOTA_TENANT_ZONE=app.rc.atonota.net
ATONOTA_TENANT_SITES=demo.app.rc.atonota.net
# Press runs only when this is 1 and the release carries the Press image. Set it to 1 after the
# first install opened the Press site (docs/dagitim/press-imaji.md). rc and prod stay 0 (blocker E-2).
ATONOTA_PRESS_ENABLED=0
# G-50 önerisi doğrulanmadı. Çekirdek sayısı bilinmiyor.
# 128 GB sunucuda en çok dört ortam için hesap: (128 - 64) / 4 = 16 GB.
# Web işçisi başına 1 GB, kuyruk süreci başına 2 GB varsayılır.
# Geçici web değerleri aşağıdadır. Etkin varsayılanlar compose/stack.yaml dosyasındadır.
# ATONOTA_GUNICORN_WORKERS=4
# ATONOTA_PRESS_GUNICORN_WORKERS=2
# Her kuyruk servisi için bir süreç önerilir. Press açıksa toplam iki süreç olur.
# Ayar okuyucusu bu anahtarları kabul etmez. Yorum işaretlerini kaldırmayın.
# Çekirdek ve bellek sınırlarının hesabı docs/dagitim/ortamlar.md belgesindedir.
ATONOTA_REQUIRE_ALL_COMPONENTS=1
ATONOTA_REQUIRE_OFFSITE_BACKUP=1
ATONOTA_AUTO_RESTORE_ON_FAILURE=0
