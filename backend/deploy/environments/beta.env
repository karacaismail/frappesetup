# Non-secret settings of the beta environment. Secrets live only on the server (docs/dagitim/ortamlar.md).
ATONOTA_ENV=beta
ATONOTA_PREVIOUS_ENV=alpha
ATONOTA_SSH_HOST=atonota-nonprod
ATONOTA_SSH_USER=deploy-beta
ATONOTA_BASE_HOST=beta.atonota.net
ATONOTA_ID_HOST=api.login.beta.atonota.net
ATONOTA_PRESS_HOST=press.beta.atonota.net
ATONOTA_TENANT_ZONE=app.beta.atonota.net
ATONOTA_TENANT_SITES=demo.app.beta.atonota.net
# Press runs only when this is 1 and the release carries the Press image. Set it to 1 after the
# first install opened the Press site (docs/dagitim/press-imaji.md). rc and prod stay 0 (blocker E-2).
ATONOTA_PRESS_ENABLED=0
ATONOTA_REQUIRE_ALL_COMPONENTS=0
ATONOTA_REQUIRE_OFFSITE_BACKUP=0
ATONOTA_AUTO_RESTORE_ON_FAILURE=0
