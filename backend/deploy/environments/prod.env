# Non-secret settings of the prod environment. Secrets live only on the server (docs/dagitim/ortamlar.md).
ATONOTA_ENV=prod
ATONOTA_PREVIOUS_ENV=rc
ATONOTA_SSH_HOST=atonota-prod
ATONOTA_SSH_USER=deploy-prod
ATONOTA_BASE_HOST=atonota.net
ATONOTA_ID_HOST=id.atonota.net
ATONOTA_PRESS_HOST=press.atonota.net
ATONOTA_TENANT_ZONE=app.atonota.net
ATONOTA_TENANT_SITES=demo.app.atonota.net
# Press runs only when this is 1 and the release carries the Press image. Set it to 1 after the
# first install opened the Press site (docs/dagitim/press-imaji.md). rc and prod stay 0 (blocker E-2).
ATONOTA_PRESS_ENABLED=0
ATONOTA_REQUIRE_ALL_COMPONENTS=1
ATONOTA_REQUIRE_OFFSITE_BACKUP=1
ATONOTA_AUTO_RESTORE_ON_FAILURE=0
