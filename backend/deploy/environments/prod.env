# Non-secret settings of the prod environment. Secrets live only on the server (docs/dagitim/ortamlar.md).
ATONOTA_ENV=prod
ATONOTA_PREVIOUS_ENV=rc
ATONOTA_SSH_HOST=atonota-prod
ATONOTA_SSH_USER=deploy-prod
ATONOTA_BASE_HOST=atonota.net
ATONOTA_ID_HOST=api.login.atonota.net
ATONOTA_PRESS_HOST=press.atonota.net
ATONOTA_TENANT_ZONE=app.atonota.net
ATONOTA_TENANT_SITES=demo.app.atonota.net
# Press runs only when this is 1 and the release carries the Press image. Set it to 1 after the
# first install opened the Press site (docs/dagitim/press-imaji.md). rc and prod stay 0 (blocker E-2).
ATONOTA_PRESS_ENABLED=0
# prod ortamına yalnız deneme verisi girer. Öneri gerçek müşteri yükünü kapsamaz.
# G-50 önerisi doğrulanmadı. Çekirdek sayısı bilinmiyor.
# 128 GB sunucuda en çok dört ortam için hesap: (128 - 64) / 4 = 16 GB.
# Sunucularda zamanlayıcı ve düzenli yedek açık kabul edilir.
# tenant-scheduler için 1 GB ayrılır. Bu pay doğrulanmadı.
# Yedek işi için 3 GB ayrılır. Bu pay doğrulanmadı.
# Her ortamda eşzamanlı tek yedek işi varsayılır. Dört ortam aynı anda yedek alabilir.
# İşçilere kalan bellek 16 - 1 - 3 = 12 GB olur.
# Web işçisi başına 1 GB, kuyruk süreci başına 2 GB varsayılır.
# C_env, diğer servislerden sonra ortama ayrılan çekirdek payıdır.
# C_t kiracı web payıdır. C_p Press web payıdır. C_q kuyruk payıdır.
# C_s zamanlayıcı payıdır. C_b yedek payıdır. İki işlemci payı da doğrulanmadı.
# C_s > 0 ve C_b > 0 olmalıdır. Sayıları ölçüm belirler.
# İşçi payı C_t + C_p + C_q <= C_env - C_s - C_b koşulunu sağlar.
# Ortamların C_env toplamı, diğer servislerden kalan çekirdek sayısını aşamaz.
# Geçici web değerleri aşağıdadır. Etkin varsayılanlar compose/stack.yaml dosyasındadır.
# ATONOTA_GUNICORN_WORKERS=4
# ATONOTA_PRESS_GUNICORN_WORKERS=2
# Her kuyruk servisi için bir süreç önerilir. Press açıksa toplam iki süreç olur.
# Ayar okuyucusu bu anahtarları kabul etmez. Yorum işaretlerini kaldırmayın.
# Çekirdek ve bellek sınırlarının hesabı docs/dagitim/ortamlar.md belgesindedir.
ATONOTA_REQUIRE_ALL_COMPONENTS=1
ATONOTA_REQUIRE_OFFSITE_BACKUP=1
ATONOTA_AUTO_RESTORE_ON_FAILURE=0
