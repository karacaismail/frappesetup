# Non-secret settings of the alpha environment. Secrets live only on the server (docs/dagitim/ortamlar.md).
ATONOTA_ENV=alpha
ATONOTA_PREVIOUS_ENV=
ATONOTA_SSH_HOST=atonota-nonprod
ATONOTA_SSH_USER=deploy-alpha
ATONOTA_BASE_HOST=alpha.atonota.net
ATONOTA_ID_HOST=id.alpha.atonota.net
ATONOTA_PRESS_HOST=press.alpha.atonota.net
ATONOTA_TENANT_ZONE=app.alpha.atonota.net
ATONOTA_TENANT_SITES=demo.app.alpha.atonota.net
ATONOTA_REQUIRE_ALL_COMPONENTS=0
ATONOTA_REQUIRE_OFFSITE_BACKUP=0
ATONOTA_AUTO_RESTORE_ON_FAILURE=1
