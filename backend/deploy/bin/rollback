#!/usr/bin/env bash
# Return one environment to the release before a failed one (remote/rollback does the work).
# Usage: rollback <env> <backend|web> [--failed <release id>] [--restore-backup]
# --failed <id>     after a failed deployment: undo only that release, if it changed anything
# --restore-backup  backend only: also restore the backup taken before the undone release
# Without --failed a person asked for it: the pending or current release goes back.
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

usage="usage: rollback <env> <backend|web> [--failed <release id>] [--restore-backup]"
env="${1:?$usage}"
kind="${2:?$usage}"
shift 2
load_env "$env"
case "$kind" in backend | web) ;; *) fail "unknown kind: $kind" ;; esac
options=()
while (($#)); do
    case "$1" in
    --failed)
        check_release_id "${2:?$usage}"
        options+=(--failed "$2")
        shift 2
        ;;
    --restore-backup)
        [[ "$kind" == backend ]] || fail "--restore-backup applies to backend releases only"
        options+=(--restore-backup)
        shift
        ;;
    *) fail "$usage" ;;
    esac
done
remote "$(server_bin "$env" "$kind")/rollback" "$env" "$kind" ${options[@]+"${options[@]}"}
