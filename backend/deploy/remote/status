#!/usr/bin/env bash
# Print the current release id of one kind, after checking that its containers are healthy.
# Usage: status <env> <backend|web|web-asset>
# "web-asset" prints the file name of the main script that the Vite manifest names. The /panel
# page of Frappe loads this script from /panel/assets/ (E-3).
set -euo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
. "$here/common.sh"

env="${1:?usage: status <env> <kind>}"
kind="${2:?usage: status <env> <kind>}"
check_env_name "$env"
case "$kind" in
backend)
    current="$ATONOTA_ROOT/$env/backend-current"
    [[ -L "$current" ]] || fail "$env has no backend release"
    load_host_env "$current/host.env"
    # Every service the release defines must run. "ps --all" also lists stopped containers, and a
    # service without any container is missing from it.
    services="$(stack "$current" config --services)"
    states="$(stack "$current" ps --all --format '{{.Service}} {{.State}} {{.Health}}')"
    for service in $services; do
        line="$(awk -v name="$service" '$1 == name' <<<"$states")"
        [[ -n "$line" ]] || fail "$service has no container"
        read -r _ state health <<<"$line"
        [[ "$state" == running && (-z "$health" || "$health" == healthy) ]] ||
            fail "$service is $state $health"
    done
    json_field "$current/release.json" release_id
    ;;
web)
    json_field "$ATONOTA_ROOT/web/$env/current/release.json" release_id
    ;;
web-asset)
    panel_entry "$ATONOTA_ROOT/web/$env/current"
    ;;
*) fail "unknown kind: $kind" ;;
esac
