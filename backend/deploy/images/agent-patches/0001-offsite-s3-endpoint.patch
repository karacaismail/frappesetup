diff --git a/agent/offsite_s3.py b/agent/offsite_s3.py
new file mode 100644
index 0000000..8bfffc5
--- /dev/null
+++ b/agent/offsite_s3.py
@@ -0,0 +1,58 @@
+"""S3 client settings for offsite backups, for AWS and S3-compatible storage.
+
+Press sends the offsite auth with ``ENDPOINT_URL`` (Backup Bucket ``endpoint_url``). When it is
+set, the backup goes to that S3-compatible endpoint (for example Hetzner Object Storage) instead
+of AWS. Without it, the settings are the same as before this change.
+
+Credentials are returned only as boto3 keyword arguments. rclone reads them from the environment
+(``--s3-env-auth``), so they never appear in its command line.
+"""
+
+from __future__ import annotations
+
+S3_COMPATIBLE = "S3 Compatible"
+
+
+def endpoint_url(auth: dict) -> str | None:
+    endpoint = auth.get("ENDPOINT_URL")
+    if not endpoint:
+        return None
+    if not endpoint.startswith("https://"):
+        raise KeyError("ENDPOINT_URL (must start with https://)")
+    return endpoint
+
+
+def boto3_client_kwargs(auth: dict) -> dict:
+    kwargs = {
+        "aws_access_key_id": auth["ACCESS_KEY"],
+        "aws_secret_access_key": auth["SECRET_KEY"],
+    }
+    if auth.get("REGION"):
+        kwargs["region_name"] = auth["REGION"]
+    endpoint = endpoint_url(auth)
+    if endpoint:
+        kwargs["endpoint_url"] = endpoint
+    return kwargs
+
+
+def rclone_s3_flags(auth: dict) -> list[str]:
+    """rclone flags for one offsite auth. Raises KeyError for a missing or unsupported key."""
+    region = auth["REGION"]
+    endpoint = endpoint_url(auth)
+    if endpoint:
+        provider = "Other"
+    elif auth.get("PROVIDER") == "AWS S3":
+        provider, endpoint = "AWS", f"s3.{region}.amazonaws.com"
+    elif auth.get("PROVIDER") == S3_COMPATIBLE:
+        raise KeyError("ENDPOINT_URL (required for S3 Compatible)")
+    else:
+        raise KeyError(f"PROVIDER {auth.get('PROVIDER')!r}")
+    return [
+        "--s3-provider",
+        provider,
+        "--s3-region",
+        region,
+        "--s3-endpoint",
+        endpoint,
+        "--s3-env-auth=true",
+    ]
