# identity_sync development settings. All values in this file are fake.
# Store real values in `.env`. Never commit `.env` to Git.

# Public Keycloak URL seen by the browser. It determines the token issuer (`iss`).
IDENTITY_SYNC_KEYCLOAK_PUBLIC_URL=http://identity.localhost:6110
# Set this if the service reaches Keycloak at another URL. Empty means use the public URL.
IDENTITY_SYNC_KEYCLOAK_INTERNAL_URL=
IDENTITY_SYNC_REALM=platform
# Internal Keycloak realm ID, sent as `realmId` in Keycloak events.
# This differs from the realm name. Read it from the Keycloak admin console or Admin API.
IDENTITY_SYNC_REALM_ID=00000000-0000-4000-8000-000000000000
IDENTITY_SYNC_CLIENT_ID=identity-sync
IDENTITY_SYNC_CLIENT_SECRET=sahte-istemci-sirri
# Scope requested for the Admin API token (shared contract, section 2).
IDENTITY_SYNC_ADMIN_SCOPE=admin-api kc-admin-api
# Secret key of the preview digests (HMAC-SHA256). At least 16 characters. Keep it out of logs.
IDENTITY_SYNC_DIGEST_KEY=fake-digest-key-change-me
IDENTITY_SYNC_PRESS_URL=http://press.localhost:6113
IDENTITY_SYNC_TENANTS=[{"name":"tenant1","base_url":"http://tenant1.localhost:6111","organization":"tenant1"}]
# Signing key for the event endpoint.
IDENTITY_SYNC_WEBHOOK_SECRET=sahte-imza-anahtari
IDENTITY_SYNC_DB=./identity_sync.sqlite3
IDENTITY_SYNC_HOST=127.0.0.1
IDENTITY_SYNC_PORT=6115
# Requests one client address may send in one minute. Over the limit the answer is 429.
IDENTITY_SYNC_RATE_LIMIT=600
IDENTITY_SYNC_HTTP_TIMEOUT=10
# Wait in seconds for one anonymize call to Press or a tenant (H-5). At most 80. See README.md.
IDENTITY_SYNC_ANONYMIZE_TIMEOUT=30
# Maximum time in seconds to wait for another process to release the work lock.
IDENTITY_SYNC_LOCK_TIMEOUT=10
# Expected audience (`aud`) in the service token.
IDENTITY_SYNC_AUDIENCE=identity-sync
# Clients allowed to preview invitations. Separate client IDs with commas.
# Include the AI agent client in this list.
IDENTITY_SYNC_PREVIEW_AZP=sahte-araci-istemcisi
# Clients that may execute approved work: the service clients of the tenant sites.
# The human approves in the AI layer of the tenant site. No agent token goes here.
IDENTITY_SYNC_EXECUTE_AZP=site-tenant1-service
# Empty permission lists deny access to their corresponding endpoints.
# Service clients of platform_core sites. They may only call /v1/sessions/revoke.
# Use the service client `site-<tenant>-service`. The browser client `site-<tenant>` is refused.
IDENTITY_SYNC_SESSION_AZP=site-tenant1-service
# Only these clients may read platform queues, reconcile or replay them.
IDENTITY_SYNC_OPERATOR_AZP=identity-sync-operator
# The Press service client. It may only call /v1/account-deletions.
IDENTITY_SYNC_DELETION_AZP=press-service
