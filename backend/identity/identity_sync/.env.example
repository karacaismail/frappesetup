# identity_sync geliştirme ayarları. Bu dosyadaki bütün değerler sahtedir.
# Gerçek değerleri `.env` dosyasına yazın. `.env` Git'e girmez.

# Tarayıcının gördüğü Keycloak adresi. Belirteçteki `iss` bu adresten üretilir.
IDENTITY_SYNC_KEYCLOAK_PUBLIC_URL=http://kimlik.localhost:6110
# Servis Keycloak'a başka adresten ulaşıyorsa doldurun. Boşsa genel adres kullanılır.
IDENTITY_SYNC_KEYCLOAK_INTERNAL_URL=
IDENTITY_SYNC_REALM=platform
# Realm'in Keycloak içindeki iç kimliği. Keycloak olaylarındaki `realmId` bu değerdir.
# Değer realm adından farklıdır. Değeri Keycloak yönetim ekranından ya da Admin API'den okuyun.
IDENTITY_SYNC_REALM_ID=00000000-0000-4000-8000-000000000000
IDENTITY_SYNC_CLIENT_ID=identity-sync
IDENTITY_SYNC_CLIENT_SECRET=sahte-istemci-sirri
# Admin API belirteci bu kapsamla istenir (ortak sözleşme, 2. bölüm).
IDENTITY_SYNC_ADMIN_SCOPE=admin-api kc-admin-api
# Secret key of the preview digests (HMAC-SHA256). At least 16 characters. Keep it out of logs.
IDENTITY_SYNC_DIGEST_KEY=fake-digest-key-change-me
IDENTITY_SYNC_PRESS_URL=http://press.localhost:6113
IDENTITY_SYNC_TENANTS=[{"name":"kiraci1","base_url":"http://kiraci1.localhost:6111","organization":"kiraci1"}]
# Olay ucunun imza anahtarı.
IDENTITY_SYNC_WEBHOOK_SECRET=sahte-imza-anahtari
IDENTITY_SYNC_DB=./identity_sync.sqlite3
IDENTITY_SYNC_HOST=127.0.0.1
IDENTITY_SYNC_PORT=6115
# Requests one client address may send in one minute. Over the limit the answer is 429.
IDENTITY_SYNC_RATE_LIMIT=600
IDENTITY_SYNC_HTTP_TIMEOUT=10
# Başka sürecin iş kilidini beklemenin en uzun süresi. Birim saniyedir.
IDENTITY_SYNC_LOCK_TIMEOUT=10
# Servis belirtecinde beklenen `aud` değeri.
IDENTITY_SYNC_AUDIENCE=identity-sync
# Yalnız okuyabilen ve önizleyebilen istemciler. Virgülle ayırın.
# Yapay zekâ aracısının istemcisi bu listeye girer.
IDENTITY_SYNC_PREVIEW_AZP=sahte-araci-istemcisi
# Trusted operator approval service. Never put a tenant or agent client here.
IDENTITY_SYNC_EXECUTE_AZP=identity-sync-operator
# İki liste de boşsa servis komut uçlarındaki her isteği reddeder.
# Service clients of platform_core sites. They may only call /v1/sessions/revoke.
# Use the service client `site-<tenant>-service`. The browser client `site-<tenant>` is refused.
IDENTITY_SYNC_SESSION_AZP=site-kiraci1-service
# The Press service client. It may only call /v1/account-deletions.
IDENTITY_SYNC_DELETION_AZP=press-service
