  "clientScopeMappings": {
    "realm-management": [
      {
        "clientScope": "admin-api",
        "roles": [
          "view-users",
          "query-users",
          "manage-users",
          "view-organizations",
          "manage-organizations"
        ]
      }
    ]
  },
  "clients": [
    {
      "clientId": "site-kiraci1",
      "name": "Kiracı sitesi kiraci1",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ATONOTA_SITE_KIRACI1_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "consentRequired": false,
      "rootUrl": "${ATONOTA_SITE_KIRACI1_URL}",
      "baseUrl": "${ATONOTA_SITE_KIRACI1_URL}/panel",
      "redirectUris": [
        "${ATONOTA_SITE_KIRACI1_URL}/api/method/platform_core.api.auth.keycloak_callback"
      ],
      "webOrigins": [],
      "attributes": {
        "backchannel.logout.url": "${ATONOTA_SITE_KIRACI1_URL}/api/method/platform_core.api.keycloak_backchannel_logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "post.logout.redirect.uris": "${ATONOTA_SITE_KIRACI1_URL}/panel",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "pkce.code.challenge.method": "S256",
        "client.session.idle.timeout": "3600",
        "client.session.max.lifespan": "86400",
        "acr.loa.map": "{\"employee\": 1}",
        "default.acr.values": "employee",
        "minimum.acr.value": "employee"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email",
        "basic"
