    {
      "name": "aud-site-kiraci1",
      "description": "Belirtece yalnız site-kiraci1 hedefini ekler. Varsayılan değildir, scope ile istenir.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-site-kiraci1",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "site-kiraci1",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "name": "aud-press",
      "description": "Belirtece yalnız press hedefini ekler. Varsayılan değildir, scope ile istenir.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-press",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "press",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "name": "admin-api",
      "description": "identity-sync'in Admin API rolleri: kullanıcı okuma ve yazma, kuruluş okuma ve yazma. Yalnız Admin API için ayrı istenen belirtece girer. kc-admin-api kapsamıyla birlikte istenir.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "kc-admin-api",
      "description": "Keycloak 26.8 yerleşik kapsamı. Admin REST API hedefini belirtece ekler. Realm içe alımında istemciden önce var olsun diye burada tanımlıdır.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "admin-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-admin-api-audience-mapper",
          "consentRequired": false,
          "config": {
            "lightweight.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "clientScope": "admin-api",
        "roles": [
          "view-users",
          "query-users",
          "manage-users",
          "view-organizations",
          "manage-organizations"
        ]
      }
    ]
  },
