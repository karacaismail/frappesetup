    {
      "name": "admin-api",
      "description": "identity-sync'in Admin API rolleri: kullanıcı okuma ve yazma, kuruluş okuma ve yazma. Yalnız Admin API için ayrı istenen belirtece girer. kc-admin-api kapsamıyla birlikte istenir.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "kc-admin-api",
      "description": "Keycloak 26.8 yerleşik kapsamı. Admin REST API hedefini belirtece ekler. Realm içe alımında istemciden önce var olsun diye burada tanımlıdır.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "admin-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-admin-api-audience-mapper",
          "consentRequired": false,
          "config": {
            "lightweight.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "aud-identity-sync",
      "description": "Belirtece yalnız identity-sync hedefini ekler. Varsayılan değildir, scope ile istenir. Yalnız kiracı sitelerinin servis istemcileri ister.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-identity-sync",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "identity-sync",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
