{
  "realm": "platform",
  "enabled": true,
  "displayName": "${IDENTITY_BRAND_NAME}",
  "displayNameHtml": "${IDENTITY_BRAND_NAME}",
  "sslRequired": "${ATONOTA_SSL_REQUIRED}",
  "organizationsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "defaultLocale": "tr",
  "loginTheme": "atonota",
  "accountTheme": "atonota",
  "adminTheme": "keycloak.v2",
  "emailTheme": "atonota",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "maxDeltaTimeSeconds": 300,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and passwordHistory(5) and passwordBlacklist(yaygin-parolalar.txt) and notUsername and notEmail",
  "defaultSignatureAlgorithm": "RS256",
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyPasswordlessRpEntityName": "Atonota",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyPasswordlessRpId": "",
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "not specified",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "not specified",
  "webAuthnPolicyPasswordlessResidentKey": "required",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessCreateTimeout": 0,
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": false,
  "webAuthnPolicyPasswordlessAcceptableAaguids": [],
  "webAuthnPolicyPasswordlessExtraOrigins": [],
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "webAuthnPolicyPasswordlessMediation": "conditional",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": [
    "jboss-logging",
    "webhook"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "${ATONOTA_SMTP_HOST}",
    "port": "${ATONOTA_SMTP_PORT}",
    "from": "${ATONOTA_SMTP_FROM}",
    "fromDisplayName": "${IDENTITY_BRAND_NAME}",
    "auth": "${ATONOTA_SMTP_AUTH}",
    "ssl": "${ATONOTA_SMTP_SSL}",
    "starttls": "${ATONOTA_SMTP_STARTTLS}",
    "user": "${ATONOTA_SMTP_USER}",
    "password": "${ATONOTA_SMTP_PASSWORD}"
  },
  "clientScopes": [
    {
