# Keycloak geliştirme ortamı. Bu dosyanın kopyası .env olur. .env Git'e girmez.
# bin/kc-dev.sh betiği .env yoksa bu dosyadan üretir ve "degistir-" ile başlayan değerleri rastgele değerle doldurur.
# Portlar ve adresler PANE_PORT değişkeninden türetilir. Betik bunları kendisi verir.

# Geçici yönetici hesabı. Yalnız geliştirmede kullanılır.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=degistir-yonetici-parolasi

# Keycloak veritabanı parolası.
KC_DB_PASSWORD=degistir-veritabani-parolasi

# Realm dosyasındaki yer tutucular. Keycloak bunları açılışta ortamdan okur.
ATONOTA_SITE_TENANT1_SECRET=degistir-site-kiraci1-sirri
ATONOTA_SITE_TENANT1_SERVICE_SECRET=degistir-site-tenant1-service-sirri
ATONOTA_PRESS_SECRET=degistir-press-sirri
ATONOTA_IDENTITY_SYNC_SECRET=degistir-identity-sync-sirri
ATONOTA_PRESS_SERVICE_SECRET=degistir-press-service-sirri

# Giriş platformları (G-159). Liste identity/atonota_login/platforms/ klasöründedir.
# Bir platformun bütün değerleri doluysa "bin/kc-dev.sh platforms" platformu açar.
# Bir değer boşsa platform kapalı kalır ve giriş ekranında görünmez.
# Geliştirmede değerler boştur. Gerçek anahtar yoktur.
ATONOTA_GOOGLE_CLIENT_ID=
ATONOTA_GOOGLE_CLIENT_SECRET=
ATONOTA_APPLE_CLIENT_ID=
ATONOTA_APPLE_TEAM_ID=
ATONOTA_APPLE_KEY_ID=
ATONOTA_APPLE_P8_KEY=
ATONOTA_FACEBOOK_CLIENT_ID=
ATONOTA_FACEBOOK_CLIENT_SECRET=
ATONOTA_LINKEDIN_CLIENT_ID=
ATONOTA_LINKEDIN_CLIENT_SECRET=
ATONOTA_X_CLIENT_ID=
ATONOTA_X_CLIENT_SECRET=

# Görünen ürün adı (O-51). Giriş ekranı, e-posta ve hesap ekranı bu adı gösterir.
# Sözleşmedeki identity_brand_name ayarının Keycloak tarafıdır.
# Değer tırnaksız yazılır. Satırın geri kalanı değerdir.
IDENTITY_BRAND_NAME=AtonotA Login

# Bağlantı güvenliği. Geliştirmede yalnız dış adresler HTTPS ister. Üretimde değer "all" olur.
ATONOTA_SSL_REQUIRED=external

# E-posta. Geliştirmede Mailpit alır. Mailpit şifre ve kimlik doğrulama istemez.
# Üretim değerleri production.env.example dosyasındadır.
ATONOTA_SMTP_HOST=mailpit
ATONOTA_SMTP_PORT=1025
ATONOTA_SMTP_FROM=noreply@example.test
ATONOTA_SMTP_AUTH=false
ATONOTA_SMTP_SSL=false
ATONOTA_SMTP_STARTTLS=false
ATONOTA_SMTP_USER=mailpit-kullanmaz
ATONOTA_SMTP_PASSWORD=degistir-smtp-parolasi

# Telefon paketinin dönüş adresi. Tam adres yazılır. Doğrulanmış HTTPS bağlantısı olur (mobile.md GR-3).
ATONOTA_MOBILE_REDIRECT_URI=https://app.example.test/auth/callback
ATONOTA_MCP_REDIRECT_URI=https://mcp-client.example.test/callback
ATONOTA_MCP_RESOURCE_URL=https://tenant.example.test/api/method/platform_core.api.ai.mcp
ATONOTA_MCP_INTROSPECTION_SECRET=degistir-mcp

# Keycloak olayları identity-sync servisine imzalı gider (sözleşme 7. bölüm).
# Anahtar identity-sync servisindeki IDENTITY_SYNC_WEBHOOK_SECRET ile aynı olur. En az 16 karakterdir.
IDENTITY_SYNC_WEBHOOK_SECRET=degistir-identity-sync-olay-sirri
# Geliştirmede olaylar testlerin kayıt servisine gider. identity-sync açıksa onun /v1/events adresini yazın.
IDENTITY_SYNC_EVENTS_URL=http://event-sink.localhost:8080/v1/events

# Betik şu değerleri PANE_PORT değişkeninden üretir ve ortama koyar. Elle yazmayın.
# Türetilen: KC_PORT KC_PUBLIC_URL MAILPIT_UI_PORT ATONOTA_SITE_TENANT1_URL ATONOTA_PRESS_URL
