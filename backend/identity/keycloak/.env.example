# Keycloak development environment. A copy of this file becomes .env. .env is not committed to Git.
# If .env is missing, bin/kc-dev.sh creates it from this file and fills values starting with "degistir-" with random values.
# Ports and addresses are derived from the PANE_PORT variable. The script supplies them itself.

# Temporary admin account. Used in development only.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=degistir-yonetici-parolasi

# Keycloak database password.
KC_DB_PASSWORD=degistir-veritabani-parolasi

# Placeholders in the realm file. Keycloak reads them from the environment at start-up.
ATONOTA_SITE_TENANT1_SECRET=degistir-site-kiraci1-sirri
ATONOTA_SITE_TENANT1_SERVICE_SECRET=degistir-site-tenant1-service-sirri
ATONOTA_PRESS_SECRET=degistir-press-sirri
ATONOTA_IDENTITY_SYNC_SECRET=degistir-identity-sync-sirri
ATONOTA_PRESS_SERVICE_SECRET=degistir-press-service-sirri

# Sign-in platforms (G-159). The list is in the identity/atonota_login/platforms/ folder.
# When all values of a platform are set, "bin/kc-dev.sh platforms" enables the platform.
# If any value is empty, the platform stays disabled and does not appear on the sign-in screen.
# In development the values are empty. There are no real keys.
ATONOTA_GOOGLE_CLIENT_ID=
ATONOTA_GOOGLE_CLIENT_SECRET=
ATONOTA_APPLE_CLIENT_ID=
ATONOTA_APPLE_TEAM_ID=
ATONOTA_APPLE_KEY_ID=
ATONOTA_APPLE_P8_KEY=
ATONOTA_FACEBOOK_CLIENT_ID=
ATONOTA_FACEBOOK_CLIENT_SECRET=
ATONOTA_LINKEDIN_CLIENT_ID=
ATONOTA_LINKEDIN_CLIENT_SECRET=
ATONOTA_X_CLIENT_ID=
ATONOTA_X_CLIENT_SECRET=

# Displayed product name (O-51). The sign-in screen, emails and account screen show this name.
# This is the Keycloak side of the identity_brand_name setting in the contract.
# The value is PRODUCT_NAME from backend/brand.env. bin/kc-dev.sh reads the value from there.
# Do not change this line. If you write another name, bin/kc-dev.sh stops.
IDENTITY_BRAND_NAME=<PRODUCT_NAME>

# Connection security. In development only external addresses require HTTPS. In production the value is "all".
ATONOTA_SSL_REQUIRED=external

# Email. In development Mailpit receives it. Mailpit needs no encryption or authentication.
# Production values are in the production.env.example file.
ATONOTA_SMTP_HOST=mailpit
ATONOTA_SMTP_PORT=1025
ATONOTA_SMTP_FROM=noreply@example.test
ATONOTA_SMTP_AUTH=false
ATONOTA_SMTP_SSL=false
ATONOTA_SMTP_STARTTLS=false
ATONOTA_SMTP_USER=mailpit-kullanmaz
ATONOTA_SMTP_PASSWORD=degistir-smtp-parolasi

# Redirect address of the mobile app. Write the full address. It is a verified HTTPS link (mobile.md GR-3).
ATONOTA_MOBILE_REDIRECT_URI=https://app.example.test/auth/callback
ATONOTA_MCP_REDIRECT_URI=https://mcp-client.example.test/callback
ATONOTA_MCP_RESOURCE_URL=https://tenant.example.test/api/method/platform_core.api.ai.mcp
ATONOTA_MCP_INTROSPECTION_SECRET=degistir-mcp

# Keycloak events go signed to the identity-sync service (contract section 7).
# The key matches IDENTITY_SYNC_WEBHOOK_SECRET in the identity-sync service. It is at least 16 characters.
IDENTITY_SYNC_WEBHOOK_SECRET=degistir-identity-sync-olay-sirri
# In development events go to the tests' recording service. If identity-sync is running, write its /v1/events address.
IDENTITY_SYNC_EVENTS_URL=http://event-sink.localhost:8080/v1/events

# The script derives these values from PANE_PORT and puts them in the environment. Do not write them by hand.
# Türetilen: KC_PORT KC_PUBLIC_URL MAILPIT_UI_PORT ATONOTA_SITE_TENANT1_URL ATONOTA_PRESS_URL
