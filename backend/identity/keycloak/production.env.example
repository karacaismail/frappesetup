# Keycloak production settings. Location on the server: /etc/atonota/<environment>/keycloak.env (mode 0600).
# This file shows only key names and value formats. Real secrets are never written here.
# The development environment uses the .env.example file.
# Deployment reads this list through the backend/deploy/settings/keycloak.production.env.example link.
# Values tagged [sabit] (fixed) are security settings. The value on the server matches them.
# stack.yaml supplies KC_HOSTNAME, KC_DB, KC_DB_URL_HOST, KC_DB_URL_DATABASE and KC_DB_USERNAME itself.

# Temporary admin account for the first start. A permanent admin is created after the first setup.
KC_BOOTSTRAP_ADMIN_USERNAME=<geçici yönetici adı>
KC_BOOTSTRAP_ADMIN_PASSWORD=<geçici yönetici parolası, en az 32 rastgele karakter>
# Database password. Same as POSTGRES_PASSWORD in keycloak-db.env.
KC_DB_PASSWORD=<Keycloak veritabanı parolası, en az 32 rastgele karakter>

# Client secrets used in the realm file. Each environment has its own.
ATONOTA_SITE_TENANT1_SECRET=<kiracı tarayıcı istemcisi sırrı, en az 32 karakter>
ATONOTA_SITE_TENANT1_SERVICE_SECRET=<kiracı servis sırrı, en az 32 karakter>
ATONOTA_PRESS_SECRET=<Press istemci sırrı, en az 32 karakter>
ATONOTA_IDENTITY_SYNC_SECRET=<identity-sync istemci sırrı, en az 32 karakter>
ATONOTA_PRESS_SERVICE_SECRET=<Press servis sırrı, en az 32 karakter>

# Addresses used in the realm file. Full HTTPS addresses of the first tenant and of Press.
# Example: https://demo.app.<BRAND_DOMAIN> and https://press.<BRAND_DOMAIN>
ATONOTA_SITE_TENANT1_URL=<https://ilk kiracının adresi>
ATONOTA_PRESS_URL=<https://Press adresi>

# Sign-in platforms (G-159). The platform list is in the identity/atonota_login/platforms/ folder.
# A platform is enabled when all its values are set. If any value is empty, the platform stays disabled.
# To enable: identity/atonota_login/bin/atonota-login apply. Details in docs/handoff/atonota-login-platforms.md.
# [isteğe bağlı] Google sign-in is disabled in the realm. Enabling it requires both values.
ATONOTA_GOOGLE_CLIENT_ID=<Google istemci kimliği, örnek: 123-abc.apps.googleusercontent.com>
# [isteğe bağlı] Google client secret.
ATONOTA_GOOGLE_CLIENT_SECRET=<Google istemci sırrı>
# [isteğe bağlı] Sign in with Apple is disabled in the realm. Enabling it requires all four values.
ATONOTA_APPLE_CLIENT_ID=<Apple servis kimliği>
# [isteğe bağlı] Apple team ID.
ATONOTA_APPLE_TEAM_ID=<Apple ekip kimliği, 10 karakter>
# [isteğe bağlı] Apple key ID.
ATONOTA_APPLE_KEY_ID=<Apple anahtar kimliği, 10 karakter>
# [isteğe bağlı] Apple private key. May stay empty while Apple is disabled.
ATONOTA_APPLE_P8_KEY=<Apple .p8 anahtarının içeriği>
# [isteğe bağlı] Facebook sign-in. Enabling it requires both values.
ATONOTA_FACEBOOK_CLIENT_ID=<Facebook uygulama kimliği>
# [isteğe bağlı] Facebook app secret.
ATONOTA_FACEBOOK_CLIENT_SECRET=<Facebook uygulama sırrı>
# [isteğe bağlı] LinkedIn sign-in. Enabling it requires both values.
ATONOTA_LINKEDIN_CLIENT_ID=<LinkedIn istemci kimliği>
# [isteğe bağlı] LinkedIn client secret.
ATONOTA_LINKEDIN_CLIENT_SECRET=<LinkedIn istemci sırrı>
# [isteğe bağlı] X sign-in. Keycloak uses an OAuth 1.0a key for X. Enabling it requires both values.
ATONOTA_X_CLIENT_ID=<X API anahtarı>
# [isteğe bağlı] X API key secret.
ATONOTA_X_CLIENT_SECRET=<X API anahtar sırrı>

# Displayed product name (O-51). The value is PRODUCT_NAME from backend/brand.env.
# Do not type the value by hand. Write the value without quotes.
IDENTITY_BRAND_NAME=<PRODUCT_NAME>
# [sabit] Every request requires HTTPS.
ATONOTA_SSL_REQUIRED=all

# The mail server connects encrypted with STARTTLS on port 587. It requires a username and password.
# The mail provider has not been chosen yet (blocker E-12).
ATONOTA_SMTP_HOST=<SMTP sunucusunun adı>
# [sabit] STARTTLS port.
ATONOTA_SMTP_PORT=587
ATONOTA_SMTP_FROM=<gönderen adresi, örnek: noreply@alan-adi.example>
# [sabit] Authentication enabled.
ATONOTA_SMTP_AUTH=true
# [sabit] Direct TLS disabled. Encryption uses STARTTLS.
ATONOTA_SMTP_SSL=false
# [sabit] STARTTLS enabled.
ATONOTA_SMTP_STARTTLS=true
ATONOTA_SMTP_USER=<SMTP kullanıcı adı>
ATONOTA_SMTP_PASSWORD=<SMTP parolası>

# Redirect address of the mobile app. It is a verified HTTPS link (mobile.md GR-3).
ATONOTA_MOBILE_REDIRECT_URI=<https://telefon uygulaması adresi/auth/callback>
# [isteğe bağlı] The realm file has a default value.
ATONOTA_MCP_REDIRECT_URI=<https://MCP istemcisinin adresi/callback>
# [isteğe bağlı] The realm file has a default value.
ATONOTA_MCP_RESOURCE_URL=<https://kiracı adresi/api/method/platform_core.api.ai.mcp>
ATONOTA_MCP_INTROSPECTION_SECRET=<MCP denetim sırrı, en az 32 karakter>

# Settings for the extension that sends signed Keycloak events to the identity-sync service.
# The extension accepts HTTPS addresses only. In production identity-sync listens over HTTP on the internal network only.
# So production has no event address yet (blocker E-16). Both values stay empty.
# [isteğe bağlı] HTTPS address the events go to. The path is /v1/events.
KC_SPI_EVENTS_LISTENER__WEBHOOK__URL=<https://identity-sync adresi/v1/events>
# [isteğe bağlı] Signing key. Same as IDENTITY_SYNC_WEBHOOK_SECRET in identity-sync.env.
KC_SPI_EVENTS_LISTENER__WEBHOOK__SECRET=<olay imza anahtarı, en az 32 rastgele karakter>
# [isteğe bağlı] The development compose file maps these two names to the two settings above.
# Keycloak does not read these names in production. Write the values to the two keys above.
IDENTITY_SYNC_WEBHOOK_SECRET=<boş>
# [isteğe bağlı] Name of the event address in development. Not read in production.
IDENTITY_SYNC_EVENTS_URL=<boş>
