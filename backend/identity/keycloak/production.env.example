# Keycloak'ın üretim ayarları. Sunucudaki yeri: /etc/atonota/<ortam>/keycloak.env (izin 0600).
# Bu dosya yalnız anahtar adlarını ve değer biçimini gösterir. Gerçek sır bu dosyaya yazılmaz.
# Geliştirme ortamı .env.example dosyasını kullanır.
# Dağıtım bu listeyi backend/deploy/settings/keycloak.production.env.example bağıyla okur.
# [sabit] etiketli değerler güvenlik ayarıdır. Sunucudaki değer bunlarla aynı olur.
# stack.yaml KC_HOSTNAME, KC_DB, KC_DB_URL_HOST, KC_DB_URL_DATABASE ve KC_DB_USERNAME değerlerini kendisi verir.

# İlk açılıştaki geçici yönetici hesabı. İlk kurulumdan sonra kalıcı yönetici açılır.
KC_BOOTSTRAP_ADMIN_USERNAME=<geçici yönetici adı>
KC_BOOTSTRAP_ADMIN_PASSWORD=<geçici yönetici parolası, en az 32 rastgele karakter>
# Veritabanı parolası. keycloak-db.env içindeki POSTGRES_PASSWORD ile aynıdır.
KC_DB_PASSWORD=<Keycloak veritabanı parolası, en az 32 rastgele karakter>

# Realm dosyasındaki istemci sırları. Her ortamda ayrı olur.
ATONOTA_SITE_TENANT1_SECRET=<kiracı tarayıcı istemcisi sırrı, en az 32 karakter>
ATONOTA_SITE_TENANT1_SERVICE_SECRET=<kiracı servis sırrı, en az 32 karakter>
ATONOTA_PRESS_SECRET=<Press istemci sırrı, en az 32 karakter>
ATONOTA_IDENTITY_SYNC_SECRET=<identity-sync istemci sırrı, en az 32 karakter>
ATONOTA_PRESS_SERVICE_SECRET=<Press servis sırrı, en az 32 karakter>

# Realm dosyasındaki adresler. İlk kiracının ve Press'in tam HTTPS adresidir.
# Örnek: https://demo.app.atonota.net ve https://press.atonota.net
ATONOTA_SITE_TENANT1_URL=<https://ilk kiracının adresi>
ATONOTA_PRESS_URL=<https://Press adresi>

# Giriş platformları (G-159). Platform listesi identity/atonota_login/platforms/ klasöründedir.
# Bir platformun bütün değerleri doluysa platform açılır. Bir değer boşsa platform kapalı kalır.
# Açma adımı: identity/atonota_login/bin/atonota-login apply. Ayrıntı docs/handoff/atonota-login-platforms.md.
# [isteğe bağlı] Google girişi realm'de kapalıdır. Açılınca iki değer de gerekir.
ATONOTA_GOOGLE_CLIENT_ID=<Google istemci kimliği, örnek: 123-abc.apps.googleusercontent.com>
# [isteğe bağlı] Google istemci sırrı.
ATONOTA_GOOGLE_CLIENT_SECRET=<Google istemci sırrı>
# [isteğe bağlı] Apple ile giriş realm'de kapalıdır. Açılınca dört değer de gerekir.
ATONOTA_APPLE_CLIENT_ID=<Apple servis kimliği>
# [isteğe bağlı] Apple ekip kimliği.
ATONOTA_APPLE_TEAM_ID=<Apple ekip kimliği, 10 karakter>
# [isteğe bağlı] Apple anahtar kimliği.
ATONOTA_APPLE_KEY_ID=<Apple anahtar kimliği, 10 karakter>
# [isteğe bağlı] Apple özel anahtarı. Apple kapalıyken boş kalabilir.
ATONOTA_APPLE_P8_KEY=<Apple .p8 anahtarının içeriği>
# [isteğe bağlı] Facebook girişi. Açılınca iki değer de gerekir.
ATONOTA_FACEBOOK_CLIENT_ID=<Facebook uygulama kimliği>
# [isteğe bağlı] Facebook uygulama sırrı.
ATONOTA_FACEBOOK_CLIENT_SECRET=<Facebook uygulama sırrı>
# [isteğe bağlı] LinkedIn girişi. Açılınca iki değer de gerekir.
ATONOTA_LINKEDIN_CLIENT_ID=<LinkedIn istemci kimliği>
# [isteğe bağlı] LinkedIn istemci sırrı.
ATONOTA_LINKEDIN_CLIENT_SECRET=<LinkedIn istemci sırrı>
# [isteğe bağlı] X girişi. Keycloak X için OAuth 1.0a anahtarını kullanır. Açılınca iki değer de gerekir.
ATONOTA_X_CLIENT_ID=<X API anahtarı>
# [isteğe bağlı] X API anahtar sırrı.
ATONOTA_X_CLIENT_SECRET=<X API anahtar sırrı>

# Görünen ürün adı (O-51). Değer tırnaksız yazılır.
IDENTITY_BRAND_NAME=AtonotA Login
# [sabit] Bütün istekler HTTPS ister.
ATONOTA_SSL_REQUIRED=all

# E-posta sunucusu STARTTLS ile 587 portunda şifreli bağlanır. Kullanıcı adı ve parola ister.
# E-posta sağlayıcısı henüz seçilmedi (engel E-12).
ATONOTA_SMTP_HOST=<SMTP sunucusunun adı>
# [sabit] STARTTLS portu.
ATONOTA_SMTP_PORT=587
ATONOTA_SMTP_FROM=<gönderen adresi, örnek: noreply@alan-adi.example>
# [sabit] Kimlik doğrulama açık.
ATONOTA_SMTP_AUTH=true
# [sabit] Doğrudan TLS kapalı. Şifreleme STARTTLS ile olur.
ATONOTA_SMTP_SSL=false
# [sabit] STARTTLS açık.
ATONOTA_SMTP_STARTTLS=true
ATONOTA_SMTP_USER=<SMTP kullanıcı adı>
ATONOTA_SMTP_PASSWORD=<SMTP parolası>

# Telefon paketinin dönüş adresi. Doğrulanmış HTTPS bağlantısıdır (mobile.md GR-3).
ATONOTA_MOBILE_REDIRECT_URI=<https://telefon uygulaması adresi/auth/callback>
# [isteğe bağlı] Realm dosyasında varsayılan değer vardır.
ATONOTA_MCP_REDIRECT_URI=<https://MCP istemcisinin adresi/callback>
# [isteğe bağlı] Realm dosyasında varsayılan değer vardır.
ATONOTA_MCP_RESOURCE_URL=<https://kiracı adresi/api/method/platform_core.api.ai.mcp>
ATONOTA_MCP_INTROSPECTION_SECRET=<MCP denetim sırrı, en az 32 karakter>

# Keycloak olaylarını identity-sync servisine imzalı gönderen eklentinin ayarları.
# Eklenti yalnız HTTPS adres kabul eder. identity-sync üretimde yalnız iç ağda HTTP ile açılır.
# Bu yüzden üretimde olayların gideceği adres henüz yok (engel E-16). İki değer boş kalır.
# [isteğe bağlı] Olayların gideceği HTTPS adres. Yol /v1/events olur.
KC_SPI_EVENTS_LISTENER__WEBHOOK__URL=<https://identity-sync adresi/v1/events>
# [isteğe bağlı] İmza anahtarı. identity-sync.env içindeki IDENTITY_SYNC_WEBHOOK_SECRET ile aynıdır.
KC_SPI_EVENTS_LISTENER__WEBHOOK__SECRET=<olay imza anahtarı, en az 32 rastgele karakter>
# [isteğe bağlı] Geliştirme compose dosyası bu iki adı yukarıdaki iki ayara çevirir.
# Üretimde Keycloak bu adları okumaz. Değerleri yukarıdaki iki anahtara yazın.
IDENTITY_SYNC_WEBHOOK_SECRET=<boş>
# [isteğe bağlı] Geliştirmedeki olay adresinin adı. Üretimde okunmaz.
IDENTITY_SYNC_EVENTS_URL=<boş>
