# Keycloak üretim ayarlarının örneği. Değerler sahtedir. Gerçek sırlar bu dosyaya yazılmaz.
# Bu dosya üretim kurulumunu yapan DevOps sorumlusu içindir. Geliştirme ortamı .env.example dosyasını kullanır.
# Güvenlik ayarları bu dosyadaki değerlerle aynı olur:
# ATONOTA_SSL_REQUIRED=all, ATONOTA_SMTP_AUTH=true, ATONOTA_SMTP_STARTTLS=true.

KC_BOOTSTRAP_ADMIN_USERNAME=uretim-yonetici-adi
KC_BOOTSTRAP_ADMIN_PASSWORD=uretimde-gizli-kasadan
KC_DB_PASSWORD=uretimde-gizli-kasadan

ATONOTA_SITE_TENANT1_SECRET=uretimde-gizli-kasadan
ATONOTA_SITE_TENANT1_SERVICE_SECRET=uretimde-gizli-kasadan
ATONOTA_PRESS_SECRET=uretimde-gizli-kasadan
ATONOTA_IDENTITY_SYNC_SECRET=uretimde-gizli-kasadan
ATONOTA_PRESS_SERVICE_SECRET=uretimde-gizli-kasadan

ATONOTA_GOOGLE_CLIENT_ID=uretim-google-istemci-kimligi.apps.googleusercontent.com
ATONOTA_GOOGLE_CLIENT_SECRET=uretimde-gizli-kasadan
ATONOTA_APPLE_CLIENT_ID=uretim-apple-servis-kimligi
ATONOTA_APPLE_TEAM_ID=URETIMTEAM
ATONOTA_APPLE_KEY_ID=URETIMKEY0
ATONOTA_APPLE_P8_KEY=uretimde-gizli-kasadan

IDENTITY_BRAND_NAME=Atonota
# Bütün istekler HTTPS ister.
ATONOTA_SSL_REQUIRED=all

# E-posta sunucusu STARTTLS ile 587 portunda şifreli bağlanır ve kullanıcı adı ile parola ister.
ATONOTA_SMTP_HOST=smtp.example.test
ATONOTA_SMTP_PORT=587
ATONOTA_SMTP_FROM=noreply@example.test
ATONOTA_SMTP_AUTH=true
ATONOTA_SMTP_SSL=false
ATONOTA_SMTP_STARTTLS=true
ATONOTA_SMTP_USER=uretim-smtp-kullanicisi
ATONOTA_SMTP_PASSWORD=uretimde-gizli-kasadan

ATONOTA_MOBILE_REDIRECT_URI=https://app.example.test/auth/callback

IDENTITY_SYNC_WEBHOOK_SECRET=uretimde-gizli-kasadan
# identity-sync iç ağdaki adresidir. Ağ dışına açılmaz.
IDENTITY_SYNC_EVENTS_URL=https://identity-sync.internal.example.test/v1/events
