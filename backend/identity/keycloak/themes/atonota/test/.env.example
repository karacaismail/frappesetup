# Variables of the theme test environment. The values are fake.
# The bin/theme-dev.sh script creates the real .env file. .env is not committed to Git.
KC_PORT=3950
KC_PUBLIC_URL=http://localhost:3950
MAILPIT_UI_PORT=3951
KC_BOOTSTRAP_ADMIN_USERNAME=theme-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=sahte-deger-degistirin
# Brand name shown by the login, email and account themes. Tests use a name that differs from the theme name.
IDENTITY_BRAND_NAME=Sample Brand
# Address of the account deletion page of Press. The account console links to it for customers.
IDENTITY_ACCOUNT_DELETION_URL=http://press.localhost:3953/account/delete
# Password and TOTP secret of the made-up test users. bin/theme-dev.sh writes a random value for each new environment.
IDENTITY_TEST_PASSWORD=
IDENTITY_TEST_TOTP_SECRET=
