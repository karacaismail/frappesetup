# Tema deneme ortamının değişkenleri. Değerler sahtedir.
# bin/tema-dev.sh betiği gerçek .env dosyasını üretir. .env Git'e girmez.
KC_PORT=3950
KC_PUBLIC_URL=http://localhost:3950
MAILPIT_UI_PORT=3951
KC_BOOTSTRAP_ADMIN_USERNAME=tema-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=sahte-deger-degistirin
# Brand name shown by the login, email and account themes. Tests use a name that differs from the theme name.
IDENTITY_BRAND_NAME=Sample Brand
