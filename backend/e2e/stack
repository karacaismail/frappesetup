def stack_realm(realm, environment):
    origin = tenant_browser_origin(environment)
    if origin != environment["ATONOTA_SITE_TENANT1_URL"]:
        tenant = next(client for client in realm["clients"] if client["clientId"] == "site-tenant1")
        tenant["redirectUris"].append(origin + TENANT_CALLBACK)
        logout_uris = tenant["attributes"]["post.logout.redirect.uris"]
        recovery = "/api/method/platform_core.api.auth.start_login?switch_account=1"
        tenant["attributes"]["post.logout.redirect.uris"] = "##".join(
            (logout_uris, origin + "/panel", origin + recovery)
        )
    return realm


