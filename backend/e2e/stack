    address = start_provider(engine, environment)
    password, browser_fixtures, lifecycle, sync_client = fixtures.seed_identities(port)
    settings = {
        "PANE_PORT": environment["PANE_PORT"],
        "E2E_PROVIDER_IP": address,
        "E2E_PREVIEW_SYNC_ORIGIN": environment["IDENTITY_SYNC_EVENTS_URL"].rsplit("/v1/events", 1)[0],
        "E2E_PREVIEW_LOGIN_EMAIL": fixtures.LOGIN_EMAIL,
