    tenant = _seed_output(
        run(
            [*compose, "exec", "-T", "tenant-web", "env/bin/python", "-c",
             (BACKEND / "e2e/preview/site-seed.py").read_text(), "stack-tenant"],
            environment,
            input=json.dumps(settings),
            text=True,
            stdout=subprocess.PIPE,
        )
