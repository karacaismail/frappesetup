def stop_provider(engine, environment):
    """Remove this stack's fake model provider. Compose does not own it, so down alone misses it."""
    label = f"label={EXTRA_LABEL}={project_name(environment)}"
    ids = container_ids(
        run([*engine, "ps", "-aq", "--filter", label], environment, capture_output=True, text=True).stdout
    )
    if ids:
        run([*engine, "rm", "-f", *ids], environment, stdout=subprocess.DEVNULL)


def start_provider(engine, environment):
    """Start the fake model provider on the stack network and return its private address.

    The provider runs from the tenant image. The image holds Compose's project and service labels,
    so the run clears them and adds the stack's own extra label instead (T-17).
    """
    project = project_name(environment)
    name = f"{project}-provider"
    port = int(environment["PANE_PORT"]) + 7
    running = run(
        [*engine, "ps", "-q", "--filter", f"name=^{name}$"], environment, capture_output=True, text=True
    ).stdout.strip()
    if not running:
        image = run(
            [*engine, "inspect", "--format", "{{.Config.Image}}", f"{project}-tenant-web-1"],
            environment,
            capture_output=True,
            text=True,
        ).stdout.strip()
        run(
            [
                *engine, "run", "-d", "--rm", "--name", name,
                "--label", "com.docker.compose.project=", "--label", "com.docker.compose.service=",
                "--label", f"{EXTRA_LABEL}={project}",
                "--network", f"{project}_default", "--network-alias", PROVIDER_ALIAS, "--memory", "96m",
                "--publish", f"127.0.0.1:{port}:{port}",
                "--env", f"PANE_PORT={environment['PANE_PORT']}", "--env", "E2E_PROVIDER_BIND=0.0.0.0",
                "--entrypoint", "node", image,
                "--input-type=module", "-e", (BACKEND / "e2e/fake-provider.mjs").read_text(),
            ],
            environment,
            capture_output=True,
            text=True,
        )
    address = run(
        [*engine, "inspect", "--format",
         "{{(index .NetworkSettings.Networks \"%s_default\").IPAddress}}" % project, name],
        environment,
        capture_output=True,
        text=True,
    ).stdout.strip()
    try:
        parsed = ipaddress.ip_address(address)
    except ValueError:
        parsed = None
    if not parsed or not parsed.is_private or parsed.is_loopback or parsed.is_link_local:
        raise ValueError("The fake model provider has no private address on the stack network.")
    return address


def seed_preview(engine, compose, environment):
    """Prepare the API and browser test data on a running stack (MVP test 3, T-16).

    The merge preview's helpers seed Keycloak from this computer and the tenant inside its
    container. The tenant keeps the Keycloak settings that stack up wrote. Press is not seeded
    here: seed-deletion prepares the Press deletion chain. Run it once on a new stack.
    """
    require_tenant_settings(environment)
    require_realm_sync_settings(environment)
    fixtures = preview_fixtures()
    port = int(environment["KC_PORT"])
    os.environ.pop("E2E_BROWSER_RUNTIME", None)
