def main():
    parser = argparse.ArgumentParser(
        description=__doc__, epilog=ACTION_HELP, formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "action", choices=ACTIONS, metavar="action",
        help="one of: " + ", ".join(ACTIONS),
    )
    args = parser.parse_args()
    try:
        environment, engine, compose = setup()
        if args.action == "config":
            model = config(compose, environment)
            # Deliberate allowlist: Compose's resolved environment contains secrets.
            print(
                json.dumps(
                    {
                        "name": model["name"],
                        "services": {
                            name: {
                                key: service[key] for key in ("image", "ports", "networks") if key in service
                            }
                            for name, service in model["services"].items()
                        },
                    },
                    indent=2,
                )
            )
        elif args.action == "build":
            assert_owner(engine, compose, environment)
            check_resources(engine, environment)
            run([*compose, "build", "web"], environment)
        elif args.action == "up":
            # Check local settings before the ownership probe or any other Docker call.
            require_press_settings(environment)
            require_realm_sync_settings(environment)
            require_tenant_login_settings(environment)
            assert_owner(engine, compose, environment, create=True)
            up(engine, compose, environment)
        elif args.action == "down":
            assert_owner(engine, compose, environment)
            stop_provider(engine, environment)
            run([*compose, "down"], environment)
        elif args.action == "check":
            check(compose, environment)
        elif args.action == "seed-deletion":
            assert_owner(engine, compose, environment)
            path = env_file(os.environ.get("E2E_FIXTURE_FILE", REPOSITORY / ".pane/scratch/e2e-deletion.env"))
            assert_ignored(path)
            write_fixture(path, seed_deletion(compose, environment))
            print(f"Deletion fixture written to {path}")
        elif args.action == "review-accounts":
            # Refuse a non-local stack before the ownership probe or any other Docker call.
            require_local_stack(environment)
            assert_owner(engine, compose, environment)
            summary = review_accounts(compose, environment)
            print("Review accounts ready. See backend/e2e/README.md.")
            print(json.dumps(summary, indent=2))
        elif args.action == "seed-preview":
            assert_owner(engine, compose, environment)
            path = env_file(os.environ.get("E2E_FIXTURE_FILE", REPOSITORY / ".pane/scratch/e2e-preview.env"))
            assert_ignored(path)
            write_fixture(path, seed_preview(engine, compose, environment))
            print(f"Preview fixture written to {path}")
        else:
            resources(engine, environment)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2
    except RuntimeError as error:
        # The preview fixture helpers raise RuntimeError without tokens or response bodies.
        print(str(error), file=sys.stderr)
        return 1
    except (OSError, subprocess.CalledProcessError):
        print(
            "Stack command failed. Run stack down to close this project's services.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
