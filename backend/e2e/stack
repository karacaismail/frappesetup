from pathlib import Path

BACKEND = Path(__file__).resolve().parents[1]
# Tests may move BACKEND. The trusted credential root stays this checkout.
REPOSITORY = Path(__file__).resolve().parents[2]
CONTAINER_ID = re.compile(r"[0-9a-f]{12,64}")
REQUIRED_SETTING = re.compile(r"\$\{([A-Z][A-Z0-9_]*):\?[^}]*\}")
INCLUDE_FILE = re.compile(r"^\s*-\s*(?:path:\s*)?([A-Za-z0-9_.-]+\.ya?ml)\s*$")
SECRET_PREFIXES = ("degistir-", "example-only-")
SECRET_KEY = re.compile(r"(?:^|_)(?:SECRET|PASSWORD|TOKEN|P8_KEY)(?:_|$)")
REDIS = "redis:7.4-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499"


def template_entries():
    root = BACKEND if (BACKEND / "dev/.env.example").is_file() else REPOSITORY / "backend"
    for template in (
        root / "dev/.env.example",
        root / "identity/keycloak/.env.example",
        root / "dev/press/.env.example",
    ):
        for line in template.read_text().splitlines():
            key, separator, value = line.partition("=")
            if not separator or not key or key.startswith("#"):
                continue
            yield key, value


def default_settings():
    """Return non-secret template defaults without touching E2E_ENV_FILE.

    A key that names a credential is never filled, even when the template holds a fake value.
    """
    return {
        key: value
        for key, value in template_entries()
        if not value.startswith(SECRET_PREFIXES) and not SECRET_KEY.search(key)
    }


def project_name(environment):
    """Give each canonical worktree and port base a stable resource namespace."""
    port = environment["PANE_PORT"]
    digest = hashlib.sha256(f"{BACKEND.resolve()}\n{port}".encode()).hexdigest()[:20]
    return f"fs-e2e-{port}-{digest}"


def env_file(value):
    """Return a canonical environment file path inside this checkout."""
    value = str(value)
    if any(character in value for character in "\0\r\n"):
        raise ValueError("E2E_ENV_FILE contains a control character.")
    path = Path(value)
    if path.name in ("", ".", ".."):
        raise ValueError("E2E_ENV_FILE must name a file.")
    # Resolve only the parent: credentials() must still reject a symlinked file.
    path = Path(os.path.abspath(path.parent)).resolve() / path.name
    if not path.is_relative_to(REPOSITORY.resolve()):
        raise ValueError(f"E2E_ENV_FILE must be inside {REPOSITORY}.")
    return path


def assert_ignored(path):
    """Refuse a credential path that Git could add to the public repository."""
    git = shutil.which("git")
    if not git:
        raise ValueError("Git is required to check that E2E_ENV_FILE is ignored by Git.")
    # GIT_* variables could point the check at another repository.
    clean = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    result = run(
        [git, "-C", str(REPOSITORY), "check-ignore", "-q", "--", str(path)],
        clean,
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        raise ValueError("E2E_ENV_FILE must be a path that is ignored by Git.")


def container_ids(output):
    ids = output.split()
    if not all(CONTAINER_ID.fullmatch(value) for value in ids):
        raise ValueError("Docker returned an invalid container ID.")
    return ids


def run(command, environment, check=True, **kwargs):
    """Run Docker without a shell after checking every argument."""
    if not command or not all(isinstance(argument, str) and "\0" not in argument for argument in command):
        raise ValueError("Commands must be non-empty text arguments without NUL bytes.")
    if "--env-file" in command:
        index = command.index("--env-file") + 1
        if index >= len(command) or str(env_file(command[index])) != command[index]:
            raise ValueError("The Compose environment file was not validated.")
    return subprocess.run(command, env=environment, check=check, **kwargs)


def credentials(path):
    """Read plain dotenv values, never execute them as shell code."""
    if not path.exists() and not path.is_symlink():
        values = {
            key: secrets.token_urlsafe(32) if value.startswith(SECRET_PREFIXES) else value
            for key, value in template_entries()
        }
        path.parent.mkdir(parents=True, exist_ok=True)
        # The staging file holds secrets too, so Git must ignore its name before it exists.
        # The name is independent of the target so one narrow .gitignore rule covers it.
        staging = path.parent / f".fs-stack-env.{secrets.token_hex(8)}.tmp"
        assert_ignored(staging)
        descriptor = os.open(staging, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with os.fdopen(descriptor, "w") as stream:
                stream.write("".join(f"{key}={value}\n" for key, value in values.items()))
                stream.flush()
                os.fsync(stream.fileno())
                # Publish only complete credentials and never overwrite a competing writer.
                try:
                    os.link(staging, path)
                except FileExistsError:
                    pass
        finally:
            staging.unlink(missing_ok=True)
    metadata = path.lstat()
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_mode & 0o077:
        raise ValueError("The environment file must be a private regular file (0600).")
    values = {}
    for line in path.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise ValueError("Invalid environment file syntax.")
        values[key] = value
    return values


def setup():
    port = os.environ.get("PANE_PORT", "")
    if not re.fullmatch(r"[1-9][0-9]{3,4}", port) or int(port) > 65526:
        raise ValueError("PANE_PORT must be an integer from 1000 to 65526.")
    profile = os.environ.get("FS_COLIMA_PROFILE", "factory")
    if profile not in ("factory", "default"):
        raise ValueError("FS_COLIMA_PROFILE must be factory or default.")
    port = int(port)
    context = "colima-factory" if profile == "factory" else "colima"
    path = env_file(os.environ.get("E2E_ENV_FILE", BACKEND / "e2e/.env"))
    assert_ignored(path)
    environment = {**default_settings(), **os.environ, **credentials(path)}
    environment.update(
        {
            "PANE_PORT": str(port),
            "FS_COLIMA_PROFILE": profile,
            "FS_TENANT_WEB_PORT": str(port + 1),
            "FS_TENANT_SOCKET_PORT": str(port + 2),
            "PTR_WEB_PORT": str(port + 3),
            "PTR_SOCKET_PORT": str(port + 4),
            "IDENTITY_SYNC_PORT": str(port + 5),
            "IDENTITY_SYNC_EVENTS_URL": "http://identity-sync.localhost:6115/v1/events",
            "KC_PORT": str(port),
            "KC_PUBLIC_URL": f"http://identity.localhost:{port}",
            "MAILPIT_UI_PORT": str(port + 6),
            "ATONOTA_SITE_TENANT1_URL": f"http://tenant1.localhost:{port + 1}",
            "ATONOTA_PRESS_URL": f"http://press.localhost:{port + 3}",
        }
    )
    environment["FS_STACK_IMAGE_TAG"] = project_name(environment)
    if environment.get("IDENTITY_SYNC_WEBHOOK_SECRET"):
        # Domain separation keeps preview digests distinct from event signatures.
        environment["IDENTITY_SYNC_DIGEST_KEY"] = hmac.new(
            environment["IDENTITY_SYNC_WEBHOOK_SECRET"].encode(),
            b"frappesetup-e2e-preview-digest-v1",
            hashlib.sha256,
        ).hexdigest()
    engine = ["docker", "--context", context]
    compose = [
        *engine,
        "compose",
        "--project-name",
        project_name(environment),
        "--env-file",
        str(path),
        "--file",
        str(BACKEND / "dev/compose.yaml"),
    ]
    # Name missing local settings before any Docker call, whatever the action.
    require_compose_settings(compose, environment)
    return environment, engine, compose


def assert_owner(engine, compose, environment, create=False):
    """Reject foreign resources even inside the worktree's own namespace."""
    project = project_name(environment)
    env_path = str(Path(compose[compose.index("--env-file") + 1]).resolve())
    owner = hashlib.sha256(
        f"{BACKEND.resolve()}\n{environment['PANE_PORT']}\n{env_path}".encode()
    ).hexdigest()
    marker = project + "-owner"
    label = "io.frappesetup.stack-owner"
    ids = container_ids(
        run(
            [*engine, "ps", "-aq", "--filter", f"label=com.docker.compose.project={project}"],
            environment,
            capture_output=True,
            text=True,
        ).stdout
    )
    if ids:
        containers = json.loads(
            run([*engine, "inspect", *ids], environment, capture_output=True, text=True).stdout
        )
        for container in containers:
            labels = container["Config"].get("Labels") or {}
            name = container.get("Name", "").lstrip("/") or container.get("Id", "")[:12]
            working_dir = labels.get("com.docker.compose.project.working_dir")
            if not working_dir:
                # Compose writes its project label into every image it builds. A container that
                # `docker run` starts from the stack's tenant image inherits that label (T-17).
                raise ValueError(
                    f"Container {name} carries this stack's Compose project label, but Compose did not "
                    "start it. It was probably started with docker run from the stack's tenant image, "
                    "which holds the label. Stop that container, or start it with "
                    "--label com.docker.compose.project= so that it leaves the project."
                )
            if working_dir != str(BACKEND / "dev"):
                raise ValueError(
                    f"This Compose project belongs to another worktree: container {name} was started "
                    f"from {working_dir}."
                )
            recorded_env = labels.get("com.docker.compose.project.environment_file")
            if not recorded_env or str(Path(recorded_env).resolve()) != env_path:
                raise ValueError("This Compose project uses another environment file.")
            for item in container["Config"].get("Env", []):
                key, _, value = item.partition("=")
                if key in ("KC_HTTP_PORT", "FS_TENANT_WEB_PORT", "PTR_WEB_PORT"):
                    expected = environment["KC_PORT" if key == "KC_HTTP_PORT" else key]
                    if value != expected:
                        raise ValueError("This Compose project uses another Pane port range.")
    volumes = run(
        [*engine, "volume", "ls", "--format", "{{.Name}}"], environment, capture_output=True, text=True
    ).stdout.splitlines()
    if marker not in volumes and any(name.startswith(project + "_") for name in volumes):
        raise ValueError("Unclaimed stack volumes exist. Their ownership must be checked before reuse.")
    if create and marker not in volumes:
        run(
            [*engine, "volume", "create", "--label", f"{label}={owner}", marker],
            environment,
            stdout=subprocess.DEVNULL,
        )
    if create or marker in volumes:
        result = run([*engine, "volume", "inspect", marker], environment, capture_output=True, text=True)
        actual = json.loads(result.stdout)[0].get("Labels", {}).get(label)
        if actual != owner:
            raise ValueError("This stack's saved volumes belong to another worktree or port range.")


def compose_files(compose):
    entry = (
        Path(compose[compose.index("--file") + 1])
        if "--file" in compose and compose.index("--file") + 1 < len(compose)
        else BACKEND / "dev/compose.yaml"
    )
    pending = [entry]
    seen = []
    while pending:
        current = pending.pop(0)
        if current in seen or not current.is_file():
            continue
        seen.append(current)
        for line in current.read_text().splitlines():
            match = INCLUDE_FILE.match(line)
            if match:
                pending.append(current.parent / match.group(1))
    return seen


def required_compose_settings(compose):
    required_keys = []
    for manifest in compose_files(compose):
        text = manifest.read_text()
        # Exclude nested fallbacks like ${FS_STACK_IMAGE_TAG:-${KC_PORT:?}} when the outer variable is set.
        for outer, inner in re.findall(r"\$\{([A-Z][A-Z0-9_]*):-\$\{([A-Z][A-Z0-9_]*):\?[^}]*\}\}", text):
            text = re.sub(
                rf"\$\{{{outer}:-\$\{{{inner}:\?[^}}]*\}}\}}",
                f"${{{outer}:-}}",
                text,
            )
            required_keys.append((outer, inner))
        for key in REQUIRED_SETTING.findall(text):
            if key != "IDENTITY_SYNC_DIGEST_KEY" and key not in required_keys:
                required_keys.append(key)
    return required_keys


def require_compose_settings(compose, environment):
    """Name missing Compose settings without printing any value or starting Docker."""
    missing = []
    for item in required_compose_settings(compose):
        if isinstance(item, tuple):
            outer, inner = item
            if not environment.get(outer) and not environment.get(inner) and inner not in missing:
                missing.append(inner)
        elif not environment.get(item) and item not in missing:
            missing.append(item)
    if missing:
        raise ValueError(
            "Stack setup needs these settings: "
            + ", ".join(missing)
            + ". Copy the missing keys from the .env.example files into E2E_ENV_FILE."
        )


def config(compose, environment):
    require_compose_settings(compose, environment)
    result = run(
        [*compose, "config", "--format", "json"],
        environment,
        capture_output=True,
        text=True,
    )
    return json.loads(result.stdout)


def resources(engine, environment):
    # Read the VM filesystem and memory without SSH or a host bind mount.
    result = run(
        [
            *engine,
            "run",
            "--rm",
            "--network",
            "none",
            "--tmpfs",
            "/data",
            "--entrypoint",
            "sh",
            REDIS,
            "-c",
            "df -Pk /; free -m",
        ],
        environment,
        capture_output=True,
        text=True,
    )
    print(result.stdout, flush=True)
    lines = result.stdout.splitlines()
    disk = int(lines[1].split()[3])
    memory = int(next(line for line in lines if line.startswith("Mem:")).split()[-1])
    return disk, memory


def ensure_images(engine, compose, environment, model):
    for service in ("tenant-web", "keycloak", "event-sink", "web", "identity-sync"):
        image = model["services"][service].get("image") or f"{project_name(environment)}-{service}"
        found = subprocess.run(
            [*engine, "image", "inspect", image],
            env=environment,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        # Refresh both halves of the event contract, including the dev HTTP allowlist.
        if found.returncode or service in ("keycloak", "identity-sync"):
            run([*compose, "build", service], environment)


def check(compose, environment):
    """Probe real service protocols, not only container process state."""
    model = config(compose, environment)
    result = run(
        [*compose, "ps", "--all", "--format", "json"],
        environment,
        capture_output=True,
        text=True,
    )
    records = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]
    states = {record["Service"]: record for record in records}
    for service in model["services"]:
        record = states.get(service, {})
        if record.get("State") != "running" or record.get("Health", "") not in (
            "",
            "healthy",
        ):
            raise ValueError(f"Service is not ready: {service}")
    probes = {
        "tenant-web": [
            "env/bin/python",
            "-c",
            "import urllib.request; "
            "r=urllib.request.urlopen('http://tenant1.localhost:' + "
            "__import__('os').environ['FS_TENANT_WEB_PORT'] + '/api/method/ping', timeout=10); "
            "assert __import__('json').load(r)['message']=='pong'",
        ],
        "tenant-socket": [
            "node",
            "-e",
            "const s=require('net').connect(Number(process.env.FS_TENANT_SOCKET_PORT),'127.0.0.1',"
            "()=>s.end());s.on('error',()=>process.exit(1));s.setTimeout(5000,()=>process.exit(1));",
        ],
        "web": [
            "bash",
            "-lc",
            "cd /home/frappe/benches/frappe-bench && env/bin/python -c "
            '"import urllib.request,json,os; '
            "r=urllib.request.urlopen('http://press.localhost:'+os.environ['PTR_WEB_PORT']+"
            "'/api/method/ping', timeout=10); assert json.load(r)['message']=='pong'\"",
        ],
        "redis": ["redis-cli", "ping"],
        "identity-sync": [
            "python",
            "-c",
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6115/healthz', timeout=5)",
        ],
        "event-sink": ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080"],
        "mailpit": ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8025/livez"],
    }
    for service, command in probes.items():
        run([*compose, "exec", "-T", service, *command], environment)
        print(f"{service}: pass", flush=True)
    run(
        [
            *compose,
            "exec",
            "-T",
            "web",
            "bash",
            "-lc",
            "cd /home/frappe/benches/frappe-bench && env/bin/python -c "
            "\"import os,socket; socket.create_connection(('127.0.0.1',"
            "int(os.environ['PTR_SOCKET_PORT'])),10).close()\"",
        ],
        environment,
