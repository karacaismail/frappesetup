REVIEW_ACCOUNTS = BACKEND / "e2e/review-accounts.json"
REVIEW_SCRIPTS = {
    name: BACKEND / "e2e/preview" / f"stack-review-{name}.py" for name in ("keycloak", "tenant", "press")
}
# The production rule stays 12 characters. Only the running local Keycloak uses this while
# review-accounts sets the passwords.
REVIEW_RELAXED_LENGTH = 8
REVIEW_LOCAL_SETTINGS = ("KC_PUBLIC_URL", "ATONOTA_SITE_TENANT1_URL", "ATONOTA_PRESS_URL")
LOCAL_HOST = re.compile(r"(?:localhost|127\.0\.0\.1|[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.localhost)")
REVIEW_EMAIL = re.compile(r"inceleme-[a-z-]+@example\.test")
# G-168, G-169, G-170: sample reseller links. The reseller review accounts sign in on the stack's
# tenant site, so that site is one reseller. Every other tenant name is a synthetic example.test name.
REVIEW_TENANT_SITE = "tenant1.localhost"
SAMPLE_TENANT = re.compile(r"[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.example\.test")
SITE_STATUSES = ("Pending", "Active", "Suspended")
# G-53: no review account holds the platform operator's desk role.
OPERATOR_ROLE = "System Manager"


def load_review_accounts(path=REVIEW_ACCOUNTS):
    """Read the local review accounts. Only synthetic example.test names and a local admin name pass."""
    data = json.loads(path.read_text())
    password = data.get("password")
    accounts = data.get("accounts")
    if not isinstance(password, str) or not password or not isinstance(accounts, list) or not accounts:
        raise ValueError("review-accounts.json needs a password and a list of accounts.")
    for account in accounts:
        realm, username = account.get("realm"), account.get("username")
        if realm == "platform" and isinstance(username, str) and REVIEW_EMAIL.fullmatch(username):
            continue
        if realm == "master" and isinstance(username, str) and re.fullmatch(r"inceleme-[a-z-]+", username):
            continue
        raise ValueError("A review account must be a synthetic inceleme-*@example.test platform user"
                         " or a local inceleme-* master user.")
    for account in accounts:
        if OPERATOR_ROLE in account.get("tenant_roles", []) or account.get("role_profile") == OPERATOR_ROLE:
            raise ValueError(f"No review account may hold {OPERATOR_ROLE}. Give it a panel role profile instead.")
    check_reseller_links(data.get("reseller_links", []))
    return data


def check_reseller_links(links):
    """Each sample customer is an example.test tenant linked to one reseller only."""
    if not isinstance(links, list):
        raise ValueError("reseller_links must be a list of sample reseller links.")
    customers = set()
    for link in links:
        reseller, customer = link.get("reseller_tenant"), link.get("customer_tenant")
        if not (reseller == REVIEW_TENANT_SITE or (isinstance(reseller, str) and SAMPLE_TENANT.fullmatch(reseller))):
            raise ValueError("A sample reseller is the stack's tenant site or an example.test tenant.")
        if not isinstance(customer, str) or not SAMPLE_TENANT.fullmatch(customer) or customer in customers:
            raise ValueError("A sample reseller customer is an example.test tenant linked to one reseller only.")
        if not isinstance(link.get("customer_name"), str) or not link["customer_name"].strip():
            raise ValueError("A sample reseller customer needs a customer name.")
        if link.get("site_status") not in SITE_STATUSES:
            raise ValueError("A sample reseller customer needs a site status: " + ", ".join(SITE_STATUSES) + ".")
        customers.add(customer)


def require_local_stack(environment):
    """Stop unless every address of the stack is a plain-HTTP localhost address."""
    for key in REVIEW_LOCAL_SETTINGS:
        parts = urllib.parse.urlsplit(environment.get(key, ""))
        if (
            parts.scheme != "http"
            or not LOCAL_HOST.fullmatch(parts.hostname or "")
            or parts.path not in ("", "/")
            or parts.query
            or parts.username
        ):
            raise ValueError(f"review-accounts runs only on a local stack. {key} is not a localhost address.")


def review_accounts(compose, environment):
    """Create or update the local review accounts (backend/e2e/review-accounts.json).

    Keycloak gets the users and the shared review password, the tenant gets the roles and the
    identity links, and Press gets the identity link. The password travels on stdin only.
    """
    require_local_stack(environment)
    require_realm_sync_settings(environment)
    data = load_review_accounts()
    accounts = data["accounts"]
    issuer = environment["KC_PUBLIC_URL"] + "/realms/platform"
    keycloak = _seed_output(
        run(
            [*compose, "run", "--rm", "--no-deps", "-T", "identity-sync", "python", "-I", "-c",
             REVIEW_SCRIPTS["keycloak"].read_text()],
            environment,
            input=json.dumps(
                {
                    "keycloak_url": environment["KC_PUBLIC_URL"],
                    "admin_username": environment["KC_BOOTSTRAP_ADMIN_USERNAME"],
                    "admin_password": environment["KC_BOOTSTRAP_ADMIN_PASSWORD"],
                    "password": data["password"],
                    "relaxed_length": REVIEW_RELAXED_LENGTH,
                    # The rule of the realm file, not of the running Keycloak, so a killed
                    # earlier run cannot leave the relaxed rule in place for good.
                    "restore_policy": json.loads(REALM_FILE.read_text())["passwordPolicy"],
                    "accounts": accounts,
                }
            ),
            text=True,
            stdout=subprocess.PIPE,
        )
    )
    subjects = keycloak.get("subjects")
    if not isinstance(subjects, dict):
        raise ValueError("The Keycloak review script returned no subjects.")

    def linked(account):
        return {"email": account["username"], "subject": subjects[account["username"]]}

    tenant_accounts = [
        {**linked(account), "first_name": account["first_name"], "last_name": account["last_name"],
         "tenant_roles": account["tenant_roles"], "employee": bool(account.get("employee")),
         **({"user_type": account["user_type"]} if account.get("user_type") else {}),
         **({"role_profile": account["role_profile"]} if account.get("role_profile") else {})}
        for account in accounts if account.get("tenant_roles")
    ]
    press_accounts = [linked(account) for account in accounts if account.get("press")]
    tenant = _seed_output(
        run(
            [*compose, "exec", "-T", "tenant-web", "env/bin/python", "-c", REVIEW_SCRIPTS["tenant"].read_text()],
            environment,
            input=json.dumps(
                {"issuer": issuer, "accounts": tenant_accounts, "reseller_links": data.get("reseller_links", [])}
            ),
            text=True,
            stdout=subprocess.PIPE,
        )
    )
    press = _seed_output(
        run(
            [*compose, "exec", "-T", "--workdir", "/home/frappe/benches/frappe-bench", "web",
             "env/bin/python", "-c", REVIEW_SCRIPTS["press"].read_text()],
            environment,
            input=json.dumps({"issuer": issuer, "accounts": press_accounts}),
            text=True,
            stdout=subprocess.PIPE,
        )
    )
    return {
        "keycloak": sorted(account["username"] for account in accounts),
        "tenant": tenant.get("users", []),
        "press": press.get("users", []),
    }


def _seed_output(completed):
    """The seed scripts print one JSON object as their last line. Earlier lines are Frappe output."""
    lines = [line for line in completed.stdout.splitlines() if line.strip()]
    if not lines:
        raise ValueError("A seed script printed no result.")
    result = json.loads(lines[-1])
    if not isinstance(result, dict):
        raise ValueError("A seed script printed an invalid result.")
    return result


def write_fixture(path, fixture):
    """Write the test settings as a private dotenv file. Only E2E_ names, one line per value."""
    for key, value in fixture.items():
        if not FIXTURE_NAME.fullmatch(key) or not isinstance(value, str) or any(c in value for c in "\0\r\n"):
            raise ValueError("The fixture holds a name or value that cannot be written.")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.unlink(missing_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(descriptor, "w") as stream:
        stream.write("".join(f"{key}={value}\n" for key, value in fixture.items()))


