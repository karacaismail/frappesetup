        temporary.unlink(missing_ok=True)
"""
    run(
        [*compose, "run", "--rm", "--no-deps", "-T", "tenant-web", "env/bin/python", "-c", script],
        environment,
        input=json.dumps(tenant_login_settings(environment)),
