    )
    print("Tenant to Keycloak discovery: pass", flush=True)
    run([*compose, "ps"], environment)


def check_resources(engine, environment):
    disk, memory = resources(engine, environment)
    if disk < 10 * 1024 * 1024 or memory < 3 * 1024:
        raise ValueError("Startup requires 10 GiB free disk and 3 GiB available memory.")


