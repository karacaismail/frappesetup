    existing = fixtures.keycloak_request(
        port,
        "/admin/realms/platform/users?exact=true&email=" + fixtures.LOGIN_EMAIL,
        token=fixtures.admin_access_token(port),
    )
    if existing:
        raise ValueError(
            "This stack's Keycloak already holds the preview accounts. If the first seed-preview run "
            "finished, use the fixture file it wrote. If that run failed, the stack holds part of the "
            "fixtures and cannot be seeded again: open a new stack with another PANE_PORT."
