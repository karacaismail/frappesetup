def tenant_browser_origin(environment):
    if environment.get("FS_STACK_VITE") == "1":
        return VITE_ORIGIN
    return environment["ATONOTA_SITE_TENANT1_URL"]


def tenant_login_settings(environment):
    origin = tenant_browser_origin(environment)
    settings = {
        "keycloak_public_url": environment["KC_PUBLIC_URL"],
        "keycloak_internal_url": environment["KC_PUBLIC_URL"],
        "keycloak_client_id": "site-tenant1",
        "keycloak_client_secret": environment["ATONOTA_SITE_TENANT1_SECRET"],
        "identity_brand_name": "AtonotA Login",
        "platform_panel_url": origin + "/panel",
    }
    if environment.get("FS_STACK_VITE") == "1":
        settings["host_name"] = origin
    return settings


def configure_tenant_login(compose, environment):
    script = """import json, sys
from pathlib import Path
from tempfile import NamedTemporaryFile

path = Path("sites/tenant1.localhost/site_config.json")
config = json.loads(path.read_text())
config.update(json.load(sys.stdin))
with NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
    temporary = Path(stream.name)
    try:
        json.dump(config, stream, indent=2)
        stream.write(chr(10))
        stream.flush()
        temporary.replace(path)
