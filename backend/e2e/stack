#!/usr/bin/env python3.14
"""Start and stop the isolated tenant, Keycloak and Press development stack."""

import argparse
import hashlib
import hmac
import json
import os
import re
import secrets
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

BACKEND = Path(__file__).resolve().parents[1]
PROJECT = "fs-e2e-ortam"
REDIS = "redis:7.4-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499"


def run(command, environment, **kwargs):
    return subprocess.run(command, env=environment, check=True, **kwargs)


def credentials(path):
    """Read plain dotenv values, never execute them as shell code."""
    if not path.exists() and not path.is_symlink():
        values = {}
        for template in (
            BACKEND / "dev/.env.example",
            BACKEND / "identity/keycloak/.env.example",
            BACKEND / "dev/press/.env.example",
        ):
            for line in template.read_text().splitlines():
                if not line or line.startswith("#"):
                    continue
                key, value = line.split("=", 1)
                if value.startswith(("degistir-", "example-only-")):
                    value = secrets.token_urlsafe(32)
                values[key] = value
        path.parent.mkdir(parents=True, exist_ok=True)
        # Publish only complete credentials and never overwrite a competing writer.
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent) as stream:
            stream.write("".join(f"{key}={value}\n" for key, value in values.items()))
            stream.flush()
            os.fsync(stream.fileno())
            try:
                os.link(stream.name, path)
            except FileExistsError:
                pass
    metadata = path.lstat()
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_mode & 0o077:
        raise ValueError("The environment file must be a private regular file (0600).")
    values = {}
    for line in path.read_text().splitlines():
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise ValueError("Invalid environment file syntax.")
        values[key] = value
    return values


def setup():
    port = os.environ.get("PANE_PORT", "")
    if not re.fullmatch(r"[1-9][0-9]{3,4}", port) or int(port) > 65526:
        raise ValueError("PANE_PORT must be an integer from 1000 to 65526.")
    profile = os.environ.get("FS_COLIMA_PROFILE", "factory")
    if profile not in ("factory", "default"):
        raise ValueError("FS_COLIMA_PROFILE must be factory or default.")
    port = int(port)
    context = "colima-factory" if profile == "factory" else "colima"
    path = Path(os.environ.get("E2E_ENV_FILE", BACKEND / "e2e/.env"))
    environment = dict(os.environ, **credentials(path))
    environment.update(
        {
            "PANE_PORT": str(port),
            "FS_COLIMA_PROFILE": profile,
            "FS_TENANT_WEB_PORT": str(port + 1),
            "FS_TENANT_SOCKET_PORT": str(port + 2),
            "PTR_WEB_PORT": str(port + 3),
            "PTR_SOCKET_PORT": str(port + 4),
            "IDENTITY_SYNC_PORT": str(port + 5),
            "IDENTITY_SYNC_EVENTS_URL": "http://identity-sync.localhost:6115/v1/events",
            "KC_PORT": str(port),
            "KC_PUBLIC_URL": f"http://identity.localhost:{port}",
            "MAILPIT_UI_PORT": str(port + 6),
            "ATONOTA_SITE_TENANT1_URL": f"http://tenant1.localhost:{port + 1}",
            "ATONOTA_PRESS_URL": f"http://press.localhost:{port + 3}",
        }
    )
    # Domain separation keeps preview digests distinct from event signatures.
    environment["IDENTITY_SYNC_DIGEST_KEY"] = hmac.new(
        environment["IDENTITY_SYNC_WEBHOOK_SECRET"].encode(),
        b"frappesetup-e2e-preview-digest-v1",
        hashlib.sha256,
    ).hexdigest()
    engine = ["docker", "--context", context]
    compose = [
        *engine,
        "compose",
        "--project-name",
        PROJECT,
        "--env-file",
        str(path),
        "--file",
        str(BACKEND / "dev/compose.yaml"),
    ]
    return environment, engine, compose


def assert_owner(engine, compose, environment, create=False):
    """Keep the fixed project name from crossing worktrees or port ranges."""
    env_path = str(Path(compose[compose.index("--env-file") + 1]).resolve())
    owner = hashlib.sha256(
        f"{BACKEND.resolve()}\n{environment['PANE_PORT']}\n{env_path}".encode()
    ).hexdigest()
    marker = PROJECT + "-owner"
    label = "io.frappesetup.stack-owner"
    ids = run(
        [*engine, "ps", "-aq", "--filter", f"label=com.docker.compose.project={PROJECT}"],
        environment,
        capture_output=True,
        text=True,
    ).stdout.split()
    if ids:
        containers = json.loads(
            run([*engine, "inspect", *ids], environment, capture_output=True, text=True).stdout
        )
        for container in containers:
            labels = container["Config"].get("Labels", {})
            if labels.get("com.docker.compose.project.working_dir") != str(BACKEND / "dev"):
                raise ValueError("This Compose project belongs to another worktree.")
            recorded_env = labels.get("com.docker.compose.project.environment_file")
            if not recorded_env or str(Path(recorded_env).resolve()) != env_path:
                raise ValueError("This Compose project uses another environment file.")
            for item in container["Config"].get("Env", []):
                key, _, value = item.partition("=")
                if key in ("KC_HTTP_PORT", "FS_TENANT_WEB_PORT", "PTR_WEB_PORT"):
                    expected = environment["KC_PORT" if key == "KC_HTTP_PORT" else key]
                    if value != expected:
                        raise ValueError("This Compose project uses another Pane port range.")
    volumes = run(
        [*engine, "volume", "ls", "--format", "{{.Name}}"], environment, capture_output=True, text=True
    ).stdout.splitlines()
    if marker not in volumes and not ids and any(name.startswith(PROJECT + "_") for name in volumes):
        raise ValueError("Unclaimed stack volumes exist. Their ownership must be checked before reuse.")
    if create and marker not in volumes:
        run(
            [*engine, "volume", "create", "--label", f"{label}={owner}", marker],
            environment,
            stdout=subprocess.DEVNULL,
        )
    if create or marker in volumes:
        result = run([*engine, "volume", "inspect", marker], environment, capture_output=True, text=True)
        actual = json.loads(result.stdout)[0].get("Labels", {}).get(label)
        if actual != owner:
            raise ValueError("This stack's saved volumes belong to another worktree or port range.")


def config(compose, environment):
    result = run(
        [*compose, "config", "--format", "json"],
        environment,
        capture_output=True,
        text=True,
    )
    return json.loads(result.stdout)


def resources(engine, environment):
    # Read the VM filesystem and memory without SSH or a host bind mount.
    result = run(
        [
            *engine,
            "run",
            "--rm",
            "--network",
            "none",
            "--tmpfs",
            "/data",
            "--entrypoint",
            "sh",
            REDIS,
            "-c",
            "df -Pk /; free -m",
        ],
        environment,
        capture_output=True,
        text=True,
    )
    print(result.stdout, flush=True)
    lines = result.stdout.splitlines()
    disk = int(lines[1].split()[3])
    memory = int(next(line for line in lines if line.startswith("Mem:")).split()[-1])
    return disk, memory


def ensure_images(engine, compose, environment, model):
    for service in ("tenant-web", "keycloak", "event-sink", "web", "identity-sync"):
        image = model["services"][service].get("image", f"{PROJECT}-{service}")
        found = subprocess.run(
            [*engine, "image", "inspect", image],
            env=environment,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        # Refresh both halves of the event contract, including the dev HTTP allowlist.
        if found.returncode or service in ("keycloak", "identity-sync"):
            run([*compose, "build", service], environment)


def check(compose, environment):
    """Probe real service protocols, not only container process state."""
    model = config(compose, environment)
    result = run(
        [*compose, "ps", "--all", "--format", "json"],
        environment,
        capture_output=True,
        text=True,
    )
    records = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]
    states = {record["Service"]: record for record in records}
    for service in model["services"]:
        record = states.get(service, {})
        if record.get("State") != "running" or record.get("Health", "") not in (
            "",
            "healthy",
        ):
            raise ValueError(f"Service is not ready: {service}")
    probes = {
        "tenant-web": [
            "env/bin/python",
            "-c",
            "import urllib.request; "
            "r=urllib.request.urlopen('http://tenant1.localhost:' + "
            "__import__('os').environ['FS_TENANT_WEB_PORT'] + '/api/method/ping', timeout=10); "
            "assert __import__('json').load(r)['message']=='pong'",
        ],
        "tenant-socket": [
            "node",
            "-e",
            "const s=require('net').connect(Number(process.env.FS_TENANT_SOCKET_PORT),'127.0.0.1',"
            "()=>s.end());s.on('error',()=>process.exit(1));s.setTimeout(5000,()=>process.exit(1));",
        ],
        "web": [
            "bash",
            "-lc",
            "cd /home/frappe/benches/frappe-bench && env/bin/python -c "
            '"import urllib.request,json,os; '
            "r=urllib.request.urlopen('http://press.localhost:'+os.environ['PTR_WEB_PORT']+"
            "'/api/method/ping', timeout=10); assert json.load(r)['message']=='pong'\"",
        ],
        "redis": ["redis-cli", "ping"],
        "identity-sync": [
            "python",
            "-c",
            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6115/healthz', timeout=5)",
        ],
        "event-sink": ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080"],
        "mailpit": ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8025/livez"],
    }
    for service, command in probes.items():
        run([*compose, "exec", "-T", service, *command], environment)
        print(f"{service}: pass", flush=True)
    run(
        [
            *compose,
            "exec",
            "-T",
            "web",
            "bash",
            "-lc",
            "cd /home/frappe/benches/frappe-bench && env/bin/python -c "
            "\"import os,socket; socket.create_connection(('127.0.0.1',"
            "int(os.environ['PTR_SOCKET_PORT'])),10).close()\"",
        ],
        environment,
    )
    run(
        [
            *compose,
            "exec",
            "-T",
            "tenant-web",
            "env/bin/python",
            "-c",
            "import urllib.request,json; "
            f"issuer={environment['KC_PUBLIC_URL']!r}+'/realms/platform'; "
            "r=urllib.request.urlopen(issuer+'/.well-known/openid-configuration', timeout=10); "
            "assert json.load(r)['issuer']==issuer",
        ],
        environment,
    )
    print("Tenant to Keycloak discovery: pass", flush=True)
    run([*compose, "ps"], environment)


def check_resources(engine, environment):
    disk, memory = resources(engine, environment)
    if disk < 10 * 1024 * 1024 or memory < 3 * 1024:
        raise ValueError("Startup requires 10 GiB free disk and 3 GiB available memory.")


def up(engine, compose, environment):
    check_resources(engine, environment)
    model = config(compose, environment)
    ensure_images(engine, compose, environment, model)
    run(
        [
            *compose,
            "up",
            "-d",
            "--wait",
            "--wait-timeout",
            "180",
            "tenant-db",
            "tenant-redis",
            "mariadb",
            "redis",
            "keycloak",
            "mailpit",
            "event-sink",
        ],
        environment,
    )
    realm_id = run(
        [
            *compose,
            "exec",
            "-T",
            "keycloak-db",
            "psql",
            "-U",
            "keycloak",
            "-d",
            "keycloak",
            "-Atc",
            "SELECT id FROM realm WHERE name = 'platform'",
        ],
        environment,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", realm_id):
        raise ValueError("The platform realm must have one valid internal ID.")
    environment["IDENTITY_SYNC_REALM_ID"] = realm_id
    run([*compose, "up", "-d", "--no-build", "--wait", "identity-sync"], environment)
    run(
        [
            *compose,
            "run",
            "--rm",
            "--no-deps",
            "tenant-web",
            "env/bin/python",
            "/workspace/dev/bootstrap.py",
            "tenant1.localhost",
            "--app",
            "erpnext",
            "--app",
            "platform_core",
        ],
        environment,
    )
    run(
        [*compose, "up", "-d", "--no-build", "tenant-web", "tenant-socket", "web"],
        environment,
    )
    run(
        [
            *compose,
            "exec",
            "-T",
            "--user",
            "root",
            "web",
            "install",
            "-d",
            "-o",
            "frappe",
            "-g",
            "frappe",
            "/home/frappe/benches",
            "/home/frappe/benches/source",
        ],
        environment,
    )
    run(
        [
            *compose,
            "cp",
            str(BACKEND / "apps/press_tr"),
            "web:/home/frappe/benches/source/",
        ],
        environment,
    )
    ready = subprocess.run(
        [
            *compose,
            "exec",
            "-T",
            "web",
            "test",
            "-f",
            "/home/frappe/benches/.stack-installed",
        ],
        env=environment,
    )
    if ready.returncode:
        with (BACKEND / "dev/press/install.sh").open() as stream:
            run([*compose, "exec", "-T", "web", "bash", "-s"], environment, stdin=stream)
        run(
            [
                *compose,
                "exec",
                "-T",
                "web",
                "touch",
                "/home/frappe/benches/.stack-installed",
            ],
            environment,
        )
    else:
        run(
            [
                *compose,
                "exec",
                "-T",
                "web",
                "bash",
                "-lc",
                "cd /home/frappe/benches/frappe-bench && bench --site press.localhost migrate",
            ],
            environment,
        )
    run(
        [
            *compose,
            "exec",
            "-d",
            "web",
            "bash",
            "-lc",
            "cd /home/frappe/benches/frappe-bench && "
            'if ! curl -fsS -o /dev/null "http://press.localhost:$PTR_WEB_PORT/api/method/ping"; then '
            "exec bench start > logs/bench-start.log 2>&1; fi",
        ],
        environment,
    )
    # This is a bounded startup check, not a scheduled job.
    run(
        [
            *compose,
            "exec",
            "-T",
            "web",
            "bash",
            "-lc",
            "curl --retry 30 --retry-delay 2 --retry-connrefused --retry-all-errors "
            '--max-time 5 -fsS -o /dev/null "http://press.localhost:$PTR_WEB_PORT/api/method/ping"',
        ],
        environment,
    )
    check(compose, environment)
    resources(engine, environment)
    ids = run([*compose, "ps", "-q"], environment, capture_output=True, text=True).stdout.split()
    run(
        [*engine, "stats", "--no-stream", "--format", "{{.Name}}: {{.MemUsage}}", *ids],
        environment,
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("config", "build", "up", "down", "check", "resources"))
    args = parser.parse_args()
    try:
        environment, engine, compose = setup()
        if args.action == "config":
            model = config(compose, environment)
            # Deliberate allowlist: Compose's resolved environment contains secrets.
            print(
                json.dumps(
                    {
                        "name": model["name"],
                        "services": {
                            name: {
                                key: service[key] for key in ("image", "ports", "networks") if key in service
                            }
                            for name, service in model["services"].items()
                        },
                    },
                    indent=2,
                )
            )
        elif args.action == "build":
            assert_owner(engine, compose, environment)
            check_resources(engine, environment)
            run([*compose, "build", "web"], environment)
        elif args.action == "up":
            assert_owner(engine, compose, environment, create=True)
            up(engine, compose, environment)
        elif args.action == "down":
            assert_owner(engine, compose, environment)
            run([*compose, "down"], environment)
        elif args.action == "check":
            check(compose, environment)
        else:
            resources(engine, environment)
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2
    except (OSError, subprocess.CalledProcessError):
        print(
            "Stack command failed. Run stack down to close this project's services.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
