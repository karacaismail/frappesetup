---
import '@mantine/core/styles.css';
import '../styles/global.css';
import { ColorSchemeScript } from '@mantine/core';
import { getCollection } from 'astro:content';
import Shell, { type Heading } from '../components/Shell.tsx';

interface Props {
  title: string;
  description?: string;
  current: string;
  headings?: Heading[];
}

const {
  title,
  description = 'Frappe Headless SaaS — Press, ERPNext v16, Keycloak, headless React panel, AI katmanı ve operasyon düzlemi için mimari karar çerçevesi, 157 numaralı gereksinim ve yol haritası.',
  current,
  headings = [],
} = Astro.props;

export const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
export const REPO_URL = 'https://github.com/karacaismail/frappesetup';
export const AS_OF = '8 Ekim 2026';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const nav = [
  { href: `${BASE}/`, label: 'Genel bakış', order: 0 },
  ...docs.map((d) => ({ href: `${BASE}/${d.id}/`, label: d.data.nav, order: d.data.order })),
];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="tr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · frappesetup</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · frappesetup`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <ColorSchemeScript defaultColorScheme="auto" />
  </head>
  <body>
    <Shell
      client:load
      nav={nav}
      current={current}
      homeHref={`${BASE}/`}
      repoUrl={REPO_URL}
      headings={headings}
      asOf={AS_OF}
    >
      <slot />
    </Shell>
  </body>
</html>
