---
import { getCollection, render } from 'astro:content';
import { IconArrowLeft, IconArrowRight, IconClock } from '@tabler/icons-react';
import Site from '../layouts/Site.astro';
import Mermaid from '../components/Mermaid.tsx';
import PhaseTable from '../components/PhaseTable.astro';
import PressAiDownloads from '../components/PressAiDownloads.astro';
import RequirementsExplorer, { toRequirementRow } from '../components/RequirementsExplorer.tsx';
import Rails from '../components/Rails.astro';
import RequirementSummary from '../components/RequirementSummary.astro';
import Timeline from '../components/Timeline.astro';
import { sectionIcon } from '../components/icons';
import { SECTIONS } from '../data/sections';
import requirements from '../data/requirements.json';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const index = docs.findIndex((d) => d.id === entry.id);
const prev = index > 0 ? docs[index - 1] : null;
const next = index < docs.length - 1 ? docs[index + 1] : null;

const meta = SECTIONS[entry.id];
const Icon = sectionIcon(meta?.icon);
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 180));

const hasMermaid = (entry.body ?? '').includes('```mermaid');
// Derleme anında üretilen bloklar: markdown'daki <div data-embed="ad"> yer tutucusuna sayfa betiğiyle taşınır.
const EMBEDS: Record<string, string[]> = {
  raylar: ['rails'],
  'yol-haritasi': ['phase-table', 'timeline'],
  // press-ai indirme blokları (dl-<grup>): statik bağlantılar, dosyalar derlemede üretilir.
  'ai-mcp': ['dl-mcp'],
  'ai-skills': ['dl-skills'],
  'ai-agents': ['dl-agents'],
  'ai-gelistirme': ['dl-package'],
};
const embeds = EMBEDS[entry.id] ?? [];
---

<Site
  title={entry.data.title}
  description={meta?.summary}
  current={`${base}/${entry.id}/`}
  headings={entry.id === 'gereksinimler' ? [] : headings}
>
  <Fragment slot="head">
    {entry.id === 'gereksinimler' && (
      <script is:inline>
        if (location.hash.startsWith('#req-')) {
          const root = document.documentElement;
          root.dataset.initialRequirementLink = '';
          window.addEventListener('load', () => {
            requestAnimationFrame(() => delete root.dataset.initialRequirementLink);
          }, { once: true });
        }
      </script>
    )}
    {entry.id === 'gereksinimler' && (
      <noscript>
        <style is:inline>
          .req-explorer {
            --fs-requirements-static: yes;
          }
          .req-explorer :is(.req-search-help, .req-priority, .req-filters, .req-more, .req-detail-toggle) {
            display: none;
          }
        </style>
      </noscript>
    )}
  </Fragment>
  <div class="progress" aria-hidden><span id="progress-bar"></span></div>

  <article class="doc">
    <header class="doc-header">
      <div class="doc-kicker">
        <span class="doc-icon" aria-hidden><Icon size={20} stroke={1.75} /></span>
        <span>{meta?.group ?? 'Bölüm'}</span>
        <span class="sep" aria-hidden>·</span>
        <span>Bölüm {entry.data.order} / {docs.length}</span>
        <span class="sep" aria-hidden>·</span>
        <span class="doc-time"><IconClock size={16} aria-hidden /> {minutes} dk okuma</span>
      </div>
      <h1>{entry.data.title}</h1>
      {meta?.summary && <p class="doc-summary">{meta.summary}</p>}
    </header>

    {embeds.includes('rails') && <div data-embed-source="rails"><Rails /></div>}
    {
      embeds.includes('phase-table') && (
        <div data-embed-source="phase-table" class="prose">
          <PhaseTable />
        </div>
      )
    }
    {embeds.includes('timeline') && <div data-embed-source="timeline"><Timeline /></div>}
    {
      embeds
        .filter((e) => e.startsWith('dl-'))
        .map((e) => (
          <div data-embed-source={e}>
            <PressAiDownloads group={e.slice(3) as 'mcp' | 'skills' | 'agents' | 'package'} />
          </div>
        ))
    }

    {
      entry.id === 'gereksinimler' && (
        <div class="explorer">
          <noscript>
            <p>Arama ve süzgeçler JavaScript gerektirir. Tüm gereksinimleri aşağıda okuyabilirsiniz.</p>
          </noscript>
          <RequirementsExplorer client:visible rowsJson={JSON.stringify(requirements.map(toRequirementRow))} />
        </div>
      )
    }

    <div class="prose">
      <Content />
      {entry.id === 'gereksinimler' && (
        <>
          <h2 id="dağılım-özeti">Dağılım özeti</h2>
          <p>Sayılar derleme anında <code>requirements.json</code> dosyasından hesaplanır.</p>
          <RequirementSummary />
        </>
      )}
    </div>

    <nav class="pager" aria-label="Bölümler arası geçiş">
      {
        prev ? (
          <a class="pager-link" href={`${base}/${prev.id}/`} rel="prev">
            <span class="pager-kicker"><IconArrowLeft size={16} aria-hidden /> Önceki</span>
            <span class="pager-title">{prev.data.nav}</span>
          </a>
        ) : (
          <a class="pager-link" href={`${base}/`} rel="prev">
            <span class="pager-kicker"><IconArrowLeft size={16} aria-hidden /> Başa dön</span>
            <span class="pager-title">Genel bakış</span>
          </a>
        )
      }
      {
        next && (
          <a class="pager-link pager-next" href={`${base}/${next.id}/`} rel="next">
            <span class="pager-kicker">Sonraki <IconArrowRight size={16} aria-hidden /></span>
            <span class="pager-title">{next.data.nav}</span>
          </a>
        )
      }
    </nav>
  </article>

  {hasMermaid && <Mermaid client:idle />}
</Site>

<script>
  // 1) Derleme anında üretilen blokları metindeki yer tutucularına taşı (JS yoksa başlığın altında kalır).
  for (const source of document.querySelectorAll<HTMLElement>('[data-embed-source]')) {
    const target = document.querySelector(`[data-embed="${source.dataset.embedSource}"]`);
    if (target) target.replaceWith(source);
  }

  // 2) Başlık bağlantıları: h2/h3 kimliğine kopyalanabilir # bağlantısı.
  for (const h of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.setAttribute('aria-label', 'Bu başlığa bağlantı');
    a.textContent = '#';
    h.append(a);
  }

  // 3) Okuma ilerlemesi.
  const bar = document.getElementById('progress-bar');
  if (bar) {
    let ticking = false;
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const pct = max > 0 ? Math.min(100, Math.max(0, (doc.scrollTop / max) * 100)) : 0;
      bar.style.setProperty('--progress', `${pct}%`);
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  // 4) Satır içi kod metinle akar; satırına sığmayan kesintisiz dizinin parçası olan kod `data-scroll` alır ve kendi
  //    kutusunda kayar (global.css). Dizi kod tek başına ya da bitişik kod/metinle (ör. `a`/`b`) oluşabilir; kutuya
  //    alınan kodun iki yanı kırılabilir olur. Karar her geçişte aynı ölçüyle verilir (kodlar satır içi, satır kutusunda
  //    break-word ağı kapalı: kodun satırı taşıyor mu?), böylece durum salınmaz. Yalnız gerçekten taşan kaydırma kutusu
  //    Tab sırasına girer. Sayfanın boyutu (genişlik, kök yazı, yazı tipi), yazı tipi yüklemesi ve gezginin yeniden
  //    çizimi durumu yeniler; kutunun kaydırma konumu korunur.
  const CODE = '.prose :not(pre, a) > code, .req-detail > code';
  const lineBox = (code: HTMLElement) => {
    let box = code.parentElement!;
    while (box.parentElement && getComputedStyle(box).display === 'inline') box = box.parentElement;
    return box;
  };
  const markScrollingCode = () => {
    const codes = Array.from(document.querySelectorAll<HTMLElement>(CODE)).filter((c) => c.getClientRects().length > 0);
    const byParent = new Map<HTMLElement, HTMLElement>();
    const boxes = codes.map((code) => {
      const parent = code.parentElement!;
      const measured = byParent.get(parent) ?? lineBox(code);
      byParent.set(parent, measured);
      return measured;
    });
    const unique = new Set(boxes);
    const scrolled = codes.map((c) => c.scrollLeft);
    const was = codes.map((c) => c.getAttribute('data-scroll'));
    const focused = document.activeElement;
    for (const c of codes) c.removeAttribute('data-scroll');
    document.documentElement.setAttribute('data-code-measuring', '');
    // Satır kutusunun içerik kenarından taşan parçalar (yalnız sığmayan kesintisiz dizilerin satırları).
    const overflowing = new Map<HTMLElement, DOMRect[]>();
    const range = document.createRange();
    for (const b of unique) {
      if (b.scrollWidth <= b.clientWidth) continue;
      const cs = getComputedStyle(b);
      const right = b.getBoundingClientRect().right - parseFloat(cs.borderRightWidth) - parseFloat(cs.paddingRight);
      range.selectNodeContents(b);
      overflowing.set(b, Array.from(range.getClientRects()).filter((r) => r.width > 0 && r.right > right + 0.05));
    }
    const long = codes.map((c, i) => {
      const lines = overflowing.get(boxes[i]);
      if (!lines?.length) return false;
      return Array.from(c.getClientRects()).some((q) => lines.some((o) => o.top < q.bottom - 1 && q.top < o.bottom - 1));
    });
    document.documentElement.removeAttribute('data-code-measuring');
    codes.forEach((c, i) => {
      if (c === focused && was[i] !== null) c.setAttribute('data-scroll', was[i]);
      else if (long[i]) c.setAttribute('data-scroll', '');
    });
    const overflows = codes.map((c, i) => long[i] && c.scrollWidth > c.clientWidth);
    codes.forEach((c, i) => {
      if (c === focused) {
        // Odaktaki kod kutusu durumunu korur (tabindex kalkarsa odak gövdeye düşer); odak çıkınca yeniden ölçülür.
        c.scrollLeft = scrolled[i];
        c.addEventListener('blur', schedule, { once: true });
      } else if (overflows[i]) {
        c.setAttribute('data-scroll', 'single-line');
        c.setAttribute('tabindex', '0');
        c.setAttribute('role', 'group');
        c.setAttribute('aria-label', 'Kaydırılabilir kod');
        c.scrollLeft = scrolled[i];
      } else {
        c.removeAttribute('tabindex');
        c.removeAttribute('role');
        c.removeAttribute('aria-label');
      }
    });
  };
  const results = document.querySelector<HTMLElement>('.req-results');
  const measureResults = () => {
    if (!results) return;
    const scrolls = results.scrollWidth > results.clientWidth &&
      ['auto', 'scroll'].includes(getComputedStyle(results).overflowX);
    if (scrolls) {
      results.tabIndex = 0;
      results.setAttribute('role', 'region');
      results.setAttribute('aria-label', 'Gereksinim tablosu (yatay kaydırılabilir)');
    } else {
      results.removeAttribute('tabindex');
      results.removeAttribute('role');
      results.removeAttribute('aria-label');
    }
  };
  if (results) {
    const root = document.documentElement;
    const clearKeyboardFocus = () => delete root.dataset.requirementKeyboardFocus;
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && !event.altKey && !event.ctrlKey && !event.metaKey) {
        root.dataset.requirementKeyboardFocus = '';
      }
    });
    document.addEventListener('pointerdown', clearKeyboardFocus);
    document.addEventListener('touchstart', clearKeyboardFocus, { passive: true });
    results.addEventListener('keydown', (event) => {
      if (event.target !== results || results.tabIndex !== 0) return;
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      results.scrollBy({ left: event.key === 'ArrowRight' ? 40 : -40, behavior: 'instant' });
    });
  }
  let frame = 0;
  const schedule = () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      markScrollingCode();
      measureResults();
    });
  };
  // Ölçüm başlayınca satır içi kodda break-word ağı kapanır (global.css); betik yoksa ağ yerinde kalır.
  document.documentElement.setAttribute('data-code-measured', '');
  markScrollingCode();
  const resize = new ResizeObserver(schedule);
  resize.observe(document.body);
  if (results) {
    measureResults();
    resize.observe(results);
    const inner = results.firstElementChild;
    if (inner) resize.observe(inner);
  }
  document.fonts.addEventListener('loadingdone', schedule);
  document.fonts.ready.then(schedule);
  const explorer = document.querySelector('.explorer');
  if (explorer) new MutationObserver(schedule).observe(explorer, { childList: true, subtree: true });
</script>

<style>
  .doc {
    padding-block: 0.5rem 3rem;
  }
  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--fs-grid);
  }
  .doc-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.75rem;
    color: var(--fs-quiet);
    font-size: var(--fs-font-body);
  }
  .doc-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--mantine-radius-sm);
    background: var(--fs-accent-soft);
    color: var(--fs-chip-ink);
    margin-right: 0.25rem;
  }
  .sep {
    opacity: 0.6;
  }
  .doc-time {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .doc-header h1 {
    margin: 0;
    font-size: var(--fs-font-page-title);
    line-height: var(--fs-leading-page-title);
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 30ch;
  }
  .doc-summary {
    margin: 0.75rem 0 0;
    color: var(--fs-quiet);
    font-size: var(--fs-font-body);
    line-height: var(--fs-leading-body);
    max-width: 60ch;
    text-wrap: pretty;
  }
  .explorer {
    margin: 0 0 2.75rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--fs-grid);
  }
  @media (min-width: 36em) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--mantine-radius-md);
    background: var(--fs-surface-2);
    color: inherit;
    text-decoration: none;
    min-height: var(--fs-hit);
    transition:
      transform var(--fs-dur) var(--fs-ease),
      box-shadow var(--fs-dur) var(--fs-ease);
  }
  .pager-link:hover {
    transform: translateY(-1px);
    box-shadow: var(--fs-shadow-1);
  }
  .pager-next {
    text-align: right;
    align-items: flex-end;
  }
  .pager-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--fs-quiet);
    font-size: var(--fs-font-body);
  }
  .pager-title {
    font-weight: 650;
    font-size: var(--fs-font-card-title);
  }
</style>
