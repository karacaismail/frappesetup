---
import { getCollection, render } from 'astro:content';
import { IconArrowLeft, IconArrowRight, IconClock } from '@tabler/icons-react';
import Site from '../layouts/Site.astro';
import Mermaid from '../components/Mermaid.tsx';
import PhaseTable from '../components/PhaseTable.astro';
import RequirementsExplorer from '../components/RequirementsExplorer.tsx';
import Rails from '../components/Rails.astro';
import RequirementSummary from '../components/RequirementSummary.astro';
import Timeline from '../components/Timeline.astro';
import { sectionIcon } from '../components/icons';
import { SECTIONS } from '../data/sections';
import requirements from '../data/requirements.json';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const index = docs.findIndex((d) => d.id === entry.id);
const prev = index > 0 ? docs[index - 1] : null;
const next = index < docs.length - 1 ? docs[index + 1] : null;

const meta = SECTIONS[entry.id];
const Icon = sectionIcon(meta?.icon);
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 180));

const hasMermaid = (entry.body ?? '').includes('```mermaid');
// Derleme anında üretilen bloklar: markdown'daki <div data-embed="ad"> yer tutucusuna sayfa betiğiyle taşınır.
const EMBEDS: Record<string, string[]> = {
  raylar: ['rails'],
  'yol-haritasi': ['phase-table', 'timeline'],
  gereksinimler: ['req-summary'],
};
const embeds = EMBEDS[entry.id] ?? [];
---

<Site
  title={entry.data.title}
  description={meta?.summary}
  current={`${base}/${entry.id}/`}
  headings={entry.id === 'gereksinimler' ? [] : headings}
>
  <div class="progress" aria-hidden><span id="progress-bar"></span></div>

  <article class="doc">
    <header class="doc-header">
      <div class="doc-kicker">
        <span class="doc-icon" aria-hidden><Icon size={20} stroke={1.75} /></span>
        <span>{meta?.group ?? 'Bölüm'}</span>
        <span class="sep" aria-hidden>·</span>
        <span>Bölüm {entry.data.order} / {docs.length}</span>
        <span class="sep" aria-hidden>·</span>
        <span class="doc-time"><IconClock size={16} aria-hidden /> {minutes} dk okuma</span>
      </div>
      <h1>{entry.data.title}</h1>
      {meta?.summary && <p class="doc-summary">{meta.summary}</p>}
    </header>

    {embeds.includes('rails') && <div data-embed-source="rails"><Rails /></div>}
    {
      embeds.includes('phase-table') && (
        <div data-embed-source="phase-table" class="prose">
          <PhaseTable />
        </div>
      )
    }
    {embeds.includes('timeline') && <div data-embed-source="timeline"><Timeline /></div>}
    {
      embeds.includes('req-summary') && (
        <div data-embed-source="req-summary" class="prose">
          <RequirementSummary />
        </div>
      )
    }

    {
      entry.id === 'gereksinimler' && (
        <div class="explorer">
          <RequirementsExplorer client:visible items={requirements} />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="Bölümler arası geçiş">
      {
        prev ? (
          <a class="pager-link" href={`${base}/${prev.id}/`} rel="prev">
            <span class="pager-kicker"><IconArrowLeft size={16} aria-hidden /> Önceki</span>
            <span class="pager-title">{prev.data.nav}</span>
          </a>
        ) : (
          <a class="pager-link" href={`${base}/`} rel="prev">
            <span class="pager-kicker"><IconArrowLeft size={16} aria-hidden /> Başa dön</span>
            <span class="pager-title">Genel bakış</span>
          </a>
        )
      }
      {
        next && (
          <a class="pager-link pager-next" href={`${base}/${next.id}/`} rel="next">
            <span class="pager-kicker">Sonraki <IconArrowRight size={16} aria-hidden /></span>
            <span class="pager-title">{next.data.nav}</span>
          </a>
        )
      }
    </nav>
  </article>

  {hasMermaid && <Mermaid client:idle />}
</Site>

<script>
  // 1) Derleme anında üretilen blokları metindeki yer tutucularına taşı (JS yoksa başlığın altında kalır).
  for (const source of document.querySelectorAll<HTMLElement>('[data-embed-source]')) {
    const target = document.querySelector(`[data-embed="${source.dataset.embedSource}"]`);
    if (target) target.replaceWith(source);
  }

  // 2) Başlık bağlantıları: h2/h3 kimliğine kopyalanabilir # bağlantısı.
  for (const h of document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')) {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.setAttribute('aria-label', 'Bu başlığa bağlantı');
    a.textContent = '#';
    h.append(a);
  }

  // 3) Okuma ilerlemesi.
  const bar = document.getElementById('progress-bar');
  if (bar) {
    let ticking = false;
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const pct = max > 0 ? Math.min(100, Math.max(0, (doc.scrollTop / max) * 100)) : 0;
      bar.style.setProperty('--progress', `${pct}%`);
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .doc {
    padding-block: 0.5rem 3rem;
  }
  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--fs-grid);
  }
  .doc-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.75rem;
    color: var(--fs-quiet);
    font-size: 1rem;
  }
  .doc-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--mantine-radius-sm);
    background: var(--fs-accent-soft);
    color: var(--fs-chip-ink);
    margin-right: 0.25rem;
  }
  .sep {
    opacity: 0.6;
  }
  .doc-time {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .doc-header h1 {
    margin: 0;
    font-size: clamp(1.65rem, 1.2rem + 1.8vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 30ch;
  }
  .doc-summary {
    margin: 0.75rem 0 0;
    color: var(--fs-quiet);
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 60ch;
    text-wrap: pretty;
  }
  .explorer {
    margin: 0 0 2.75rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--fs-grid);
  }
  @media (min-width: 36em) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--mantine-radius-md);
    background: var(--fs-surface-2);
    color: inherit;
    text-decoration: none;
    min-height: 44px;
    transition:
      transform var(--fs-dur) var(--fs-ease),
      box-shadow var(--fs-dur) var(--fs-ease);
  }
  .pager-link:hover {
    transform: translateY(-1px);
    box-shadow: var(--fs-shadow-1);
  }
  .pager-next {
    text-align: right;
    align-items: flex-end;
  }
  .pager-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--fs-quiet);
    font-size: 1rem;
  }
  .pager-title {
    font-weight: 650;
    font-size: 1.0625rem;
  }
</style>
