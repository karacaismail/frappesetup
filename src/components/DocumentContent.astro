---
// Only Markdown content inside the repository and Astro components are joined as HTML.
const content = (await Astro.slots.render('default')) ?? '';
const placeholderPattern = /<div data-embed="([a-z0-9-]+)"><\/div>/g;
// Angle brackets inside the value do not close the tag.
const malformedPlaceholder = /<[a-z][\w:-]*(?:[^"'<>]|"[^"]*"|'[^']*')*?\sdata-embed(?=\s|=|\/?>)/i;

if (malformedPlaceholder.test(content.replace(placeholderPattern, ''))) {
  throw new Error('Belge bileşeni yer tutucusu <div data-embed="ad"></div> biçiminde olmalıdır.');
}

const chunks: string[] = [];
const seen = new Set<string>();
let offset = 0;

for (const match of content.matchAll(placeholderPattern)) {
  const [placeholder, name] = match;
  const start = match.index!;
  if (!Astro.slots.has(name)) throw new Error(`Bilinmeyen belge bileşeni: ${name}`);
  if (seen.has(name)) throw new Error(`Belge bileşeni yinelendi: ${name}`);
  seen.add(name);
  chunks.push(content.slice(offset, start), await Astro.slots.render(name));
  offset = start + placeholder.length;
}
chunks.push(content.slice(offset));
---

<div class="prose" set:html={chunks.join('')} />
