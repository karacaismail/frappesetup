---
// Görev panosu kuralları: durum, olgunluk düzeyi ve epic tabloları src/data/task-board.json'dan derleme anında üretilir.
import requirements from '../data/requirements.json';
import board from '../data/task-board.json';

type Item = { epic: string; status: string; level: string };
const items = board.items as Record<string, Item>;
const all = requirements.map((r) => ({ ...r, ...items[r.id] }));
const done = (list: typeof all) => list.filter((r) => r.status === 'done').length;

const auditDate = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  weekday: 'long',
  timeZone: 'UTC',
})
  .formatToParts(new Date(`${board.audit.date}T00:00:00Z`))
  .reduce<Record<string, string>>((acc, p) => ({ ...acc, [p.type]: p.value }), {});
const auditText = `${auditDate.day} ${auditDate.month} ${auditDate.year} ${auditDate.weekday}`;
const phasesOf = (list: typeof all) => [...new Set(list.map((r) => r.phase))].sort().join(', ');
---

<div class="task-rules">
  <p>
    Durumun kaynağı {auditText} günkü MVP durum denetimidir. Denetim {board.audit.commit} commit'inde yapıldı.
    {board.audit.note}
  </p>

  <h3>Durum kuralları</h3>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Tablo: Durum kuralları (yatay kaydırılabilir)">
    <table>
      <thead>
        <tr>
          <th scope="col">Durum</th>
          <th scope="col">Kural</th>
          <th scope="col">Görev</th>
        </tr>
      </thead>
      <tbody>
        {
          board.statuses.map((s) => (
            <tr>
              <th scope="row">{s.label}</th>
              <td>{s.rule}</td>
              <td>{all.filter((r) => r.status === s.id).length}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h3>Olgunluk düzeyi kuralları</h3>
  <p>
    Düzey fazdan türer. Adı yazılı istisna kalemi faz kuralının önüne geçer. Kural ile veri arasındaki uyumu test
    denetler.
  </p>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Tablo: Olgunluk düzeyi kuralları (yatay kaydırılabilir)">
    <table>
      <thead>
        <tr>
          <th scope="col">Düzey</th>
          <th scope="col">Kural</th>
          <th scope="col">İstisna kalemleri</th>
          <th scope="col">Bitti / toplam</th>
        </tr>
      </thead>
      <tbody>
        {
          board.levels.map((l) => {
            const list = all.filter((r) => r.level === l.id);
            const ids = 'ids' in l ? (l.ids as string[]) : [];
            return (
              <tr>
                <th scope="row">{l.label}</th>
                <td>{l.rule}</td>
                <td>{ids.length > 0 ? ids.join(', ') : 'Yok'}</td>
                <td>
                  {done(list)} / {list.length}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <h3>Epicler</h3>
  <p>
    Epic, aynı amaca hizmet eden görevlerin kümesidir. Epicler ray ve faz sınırını aşabilir. Örneğin "Kimlik ve oturum"
    epiği Press, Frappe ve Keycloak raylarındaki giriş işlerini birlikte gösterir.
  </p>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Tablo: Epicler (yatay kaydırılabilir)">
    <table>
      <thead>
        <tr>
          <th scope="col">Epic</th>
          <th scope="col">Amaç</th>
          <th scope="col">Fazlar</th>
          <th scope="col">Bitti / toplam</th>
        </tr>
      </thead>
      <tbody>
        {
          board.epics.map((e) => {
            const list = all.filter((r) => r.epic === e.id);
            return (
              <tr>
                <th scope="row">{e.title}</th>
                <td>{e.goal}</td>
                <td>{phasesOf(list)}</td>
                <td>
                  {done(list)} / {list.length}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</div>
